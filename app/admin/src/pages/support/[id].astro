---
import AdminLayout from "../../layouts/AdminLayout.astro";
import TicketThread from "../../components/admin/TicketThread.tsx";
import TicketStatusSelect from "../../components/admin/TicketStatusSelect.tsx";
import { TICKET_STATUS_COLORS, TICKET_STATUS_LABELS, PRIORITY_COLORS } from "../../lib/constants";
import type { AdminTicket, AdminTicketMessage } from "../../lib/types";

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";
const session = Astro.cookies.get("admin_session")?.value;
const cookieHeader = session ? { Cookie: `admin_session=${session}` } : {};

const { id } = Astro.params;

let ticket: AdminTicket | null = null;
let messages: AdminTicketMessage[] = [];
let loadError: string | null = null;
try {
  const [ticketRes, messagesRes] = await Promise.all([
    fetch(`${API_BASE}/admin/support/tickets/${encodeURIComponent(id ?? "")}`, { headers: cookieHeader }),
    fetch(`${API_BASE}/admin/support/tickets/${encodeURIComponent(id ?? "")}/messages`, { headers: cookieHeader }),
  ]);
  if (ticketRes.status === 401) {
    Astro.response.status = 401;
    loadError = "Your session has expired. Please sign out and sign in again.";
  } else if (ticketRes.status === 404) {
    Astro.response.status = 404;
  } else {
    if (!ticketRes.ok) throw new Error(`Ticket request failed (${ticketRes.status})`);
    ticket = (await ticketRes.json()).ticket;
    if (messagesRes.ok) messages = (await messagesRes.json()).messages ?? [];
  }
} catch {
  Astro.response.status = 500;
  loadError = loadError ?? "Could not load this ticket. Check that the API is running and try again.";
}

function priorityColor(priority: string) {
  return PRIORITY_COLORS[priority.toLowerCase()] ?? "bg-muted text-muted-foreground border-border";
}
---

<AdminLayout title={ticket ? `Ticket: ${ticket.subject}` : "Ticket not found"}>
  <div class="space-y-6">
    <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
      <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
      <span>/</span>
      <a href="/support" class="hover:text-foreground transition-colors">Support</a>
      <span>/</span>
      <span class="text-foreground font-medium">{id}</span>
    </nav>

    {!ticket ? (
      <div class="rounded-xl border bg-card px-4 py-12 text-center">
        <p class="text-sm font-medium text-foreground">{loadError ? "Something went wrong" : "Ticket not found"}</p>
        <p class="text-xs text-muted-foreground mt-1">{loadError ?? "It may have been deleted, or the link is wrong."}</p>
        <a href={loadError ? "/login" : "/support"} class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors mt-4">
          {loadError ? "Sign in again" : "Back to tickets"}
        </a>
      </div>
    ) : (
      <>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-foreground">{ticket.subject}</h1>
            <p class="text-sm text-muted-foreground mt-1 whitespace-pre-wrap">{ticket.description}</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class:list={[
              "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium",
              TICKET_STATUS_COLORS[ticket.status],
            ]}>
              {TICKET_STATUS_LABELS[ticket.status]}
            </span>
            <span class:list={[
              "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium capitalize",
              priorityColor(ticket.priority),
            ]}>
              {ticket.priority}
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 space-y-4">
            <div class="rounded-xl border bg-card">
              <div class="p-5 border-b border-border">
                <h2 class="font-semibold text-foreground">Conversation</h2>
              </div>
              <div class="p-5">
                <TicketThread
                  client:load
                  ticketId={ticket.id}
                  initialMessages={messages}
                  initialStatus={ticket.status}
                />
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="rounded-xl border bg-card">
              <div class="p-5 border-b border-border">
                <h2 class="font-semibold text-foreground">Details</h2>
              </div>
              <div class="p-5 space-y-3">
                <div class="flex justify-between gap-4">
                  <span class="text-sm text-muted-foreground shrink-0">Customer</span>
                  <span class="text-sm font-medium text-foreground text-right">{ticket.customerName}</span>
                </div>
                <div class="flex justify-between gap-4">
                  <span class="text-sm text-muted-foreground shrink-0">Email</span>
                  <span class="text-sm text-foreground text-right break-all">{ticket.customerEmail}</span>
                </div>
                <div class="flex justify-between gap-4">
                  <span class="text-sm text-muted-foreground shrink-0">Category</span>
                  <span class="text-sm text-foreground text-right">{ticket.category}</span>
                </div>
                <div class="flex justify-between gap-4">
                  <span class="text-sm text-muted-foreground shrink-0">Scope</span>
                  <span class="text-sm text-foreground text-right">{ticket.projectId ? "Project" : "Personal"}</span>
                </div>
                <div class="flex justify-between gap-4">
                  <span class="text-sm text-muted-foreground shrink-0">Created</span>
                  <span class="text-sm text-foreground text-right">{new Date(ticket.createdAt).toLocaleDateString()}</span>
                </div>
                <div class="flex justify-between gap-4">
                  <span class="text-sm text-muted-foreground shrink-0">Updated</span>
                  <span class="text-sm text-foreground text-right">{new Date(ticket.updatedAt).toLocaleDateString()}</span>
                </div>
              </div>
            </div>

            <div class="rounded-xl border bg-card">
              <div class="p-5 border-b border-border">
                <h2 class="font-semibold text-foreground">Actions</h2>
              </div>
              <div class="p-5">
                <TicketStatusSelect
                  client:load
                  ticketId={ticket.id}
                  initialStatus={ticket.status}
                />
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</AdminLayout>
