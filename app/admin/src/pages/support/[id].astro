---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { mockTickets, mockTicketMessages } from "../../data/tickets";

export function getStaticPaths() {
  return mockTickets.map((ticket) => ({
    params: { id: ticket.id },
  }));
}

const { id } = Astro.params;
const ticket = mockTickets.find((t) => t.id === id) || mockTickets[0];
const messages = mockTicketMessages.filter((m) => m.ticketId === ticket.id);
---

<AdminLayout title={`Ticket: ${ticket.subject}`}>
  <div class="space-y-6">
    <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
      <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
      <span>/</span>
      <a href="/support" class="hover:text-foreground transition-colors">Support</a>
      <span>/</span>
      <span class="text-foreground font-medium">{ticket.id}</span>
    </nav>

    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground">{ticket.subject}</h1>
        <p class="text-sm text-muted-foreground mt-1">{ticket.description}</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class:list={[
          "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium capitalize",
          ticket.status === "open" && "bg-info/10 text-info border-info/20",
          ticket.status === "pending" && "bg-warning/10 text-warning border-warning/20",
          ticket.status === "waiting" && "bg-muted text-muted-foreground border-border",
          ticket.status === "resolved" && "bg-success/10 text-success border-success/20",
          ticket.status === "closed" && "bg-muted text-muted-foreground border-border",
        ]}>
          {ticket.status}
        </span>
        <span class:list={[
          "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium capitalize",
          ticket.priority === "low" && "bg-muted text-muted-foreground border-border",
          ticket.priority === "normal" && "bg-info/10 text-info border-info/20",
          ticket.priority === "high" && "bg-warning/10 text-warning border-warning/20",
          ticket.priority === "urgent" && "bg-destructive/10 text-destructive border-destructive/20",
        ]}>
          {ticket.priority}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Conversation -->
      <div class="lg:col-span-2 space-y-4">
        <div class="rounded-xl border bg-card">
          <div class="p-5 border-b border-border">
            <h2 class="font-semibold text-foreground">Conversation</h2>
          </div>
          <div class="p-5 space-y-4">
            {messages.length > 0 ? messages.map((msg) => (
              <div class:list={[
                "rounded-lg p-4",
                msg.author === "admin" ? "bg-primary/5 border border-primary/10 ml-8" : "bg-muted/50 mr-8",
              ]}>
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-medium text-foreground">{msg.authorName}</span>
                    <span class:list={[
                      "text-xs px-1.5 py-0.5 rounded",
                      msg.author === "admin" ? "bg-primary/10 text-primary" : "bg-secondary text-secondary-foreground",
                    ]}>
                      {msg.author}
                    </span>
                  </div>
                  <span class="text-xs text-muted-foreground">{new Date(msg.createdAt).toLocaleString()}</span>
                </div>
                <p class="text-sm text-foreground whitespace-pre-wrap">{msg.body}</p>
              </div>
            )) : (
              <p class="text-sm text-muted-foreground text-center py-8">No messages yet.</p>
            )}

            <!-- Reply Box -->
            <div class="border border-border rounded-lg p-4 mt-4">
              <div class="flex items-center gap-2 mb-3">
                <button class="text-xs font-medium text-primary border-b-2 border-primary pb-0.5">Reply</button>
                <button class="text-xs font-medium text-muted-foreground hover:text-foreground pb-0.5">Internal Note</button>
              </div>
              <textarea
                placeholder="Type your response..."
                rows="4"
                class="w-full rounded-lg border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 resize-none"
              ></textarea>
              <div class="flex justify-end mt-3">
                <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80">
                  Send Reply
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <div class="rounded-xl border bg-card">
          <div class="p-5 border-b border-border">
            <h2 class="font-semibold text-foreground">Details</h2>
          </div>
          <div class="p-5 space-y-3">
            <div class="flex justify-between">
              <span class="text-sm text-muted-foreground">Customer</span>
              <span class="text-sm font-medium text-foreground">{ticket.customerName}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-sm text-muted-foreground">Email</span>
              <span class="text-sm text-foreground">{ticket.customerEmail}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-sm text-muted-foreground">Organization</span>
              <span class="text-sm text-foreground">{ticket.organization || "—"}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-sm text-muted-foreground">Assigned</span>
              <span class="text-sm text-foreground">{ticket.assignedAdmin || "Unassigned"}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-sm text-muted-foreground">Created</span>
              <span class="text-sm text-foreground">{new Date(ticket.createdAt).toLocaleDateString()}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-sm text-muted-foreground">Updated</span>
              <span class="text-sm text-foreground">{new Date(ticket.updatedAt).toLocaleDateString()}</span>
            </div>
          </div>
        </div>

        <div class="rounded-xl border bg-card">
          <div class="p-5 border-b border-border">
            <h2 class="font-semibold text-foreground">Actions</h2>
          </div>
          <div class="p-5 space-y-2">
            <button class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors">
              Assign to me
            </button>
            <button class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors">
              Change status
            </button>
            <button class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors">
              Change priority
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
