---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Pagination from "../../components/shared/pagination.astro";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from "../../components/ui/table";
import type { AuditLogEntry } from "../../lib/types";

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";
const session = Astro.cookies.get("admin_session")?.value;
const cookieHeader = session ? { Cookie: `admin_session=${session}` } : {};

const searchQuery = Astro.url.searchParams.get("q") ?? "";
const eventFilter = Astro.url.searchParams.get("eventType") ?? "";
const actorFilter = Astro.url.searchParams.get("actorType") ?? "";
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const LIMIT = 25;

let logs: AuditLogEntry[] = [];
let total = 0;
let totalPages = 0;
let loadError: string | null = null;
try {
  const params = new URLSearchParams();
  if (searchQuery.trim()) params.set("search", searchQuery.trim());
  if (eventFilter) params.set("eventType", eventFilter);
  if (actorFilter) params.set("actorType", actorFilter);
  params.set("limit", String(LIMIT));
  params.set("page", String(page));
  const res = await fetch(`${API_BASE}/admin/logs?${params.toString()}`, {
    headers: cookieHeader,
  });
  if (res.status === 401) {
    loadError = "Your session has expired. Please sign out and sign in again.";
  } else if (res.status === 503) {
    loadError = "Audit service is unavailable. Check that the API database is connected.";
  } else if (!res.ok) {
    throw new Error(`Request failed (${res.status})`);
  } else {
    const data = await res.json();
    logs = data.logs ?? [];
    total = data.total ?? 0;
    totalPages = data.totalPages ?? 0;
  }
} catch {
  loadError = loadError ?? "Could not load audit logs. Check that the API is running and try again.";
}

function actorColor(actorType: string) {
  if (actorType === "admin") return "bg-primary/10 text-primary border-primary/20";
  if (actorType === "system") return "bg-warning/10 text-warning border-warning/20";
  return "bg-muted text-muted-foreground border-border";
}

const pageParams: Record<string, string> = {};
if (searchQuery.trim()) pageParams.q = searchQuery.trim();
if (eventFilter) pageParams.eventType = eventFilter;
if (actorFilter) pageParams.actorType = actorFilter;

const EVENT_TYPES = [
  "user.signup",
  "user.login",
  "user.logout",
  "user.password_reset",
  "user.email_verified",
  "user.onboarding_completed",
  "user.suspended",
  "user.restored",
  "admin.login",
  "admin.logout",
  "admin.password_changed",
  "admin.created",
  "admin.approval_decided",
  "admin.removal_requested",
  "admin.totp_enabled",
  "notification.broadcast",
  "notification.scheduled",
  "notification.cancelled",
  "project.created",
  "project.environment_changed",
  "recipient.created",
  "recipient.updated",
  "recipient.deleted",
  "template.created",
  "template.updated",
  "template.deleted",
  "support.ticket_created",
  "support.ticket_replied",
  "support.ticket_status_changed",
];
---

<AdminLayout title="Audit Logs">
  <div class="space-y-6">
    <div class="space-y-1">
      <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
        <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
        <span>/</span>
        <a href="/security/audit-logs" class="hover:text-foreground transition-colors">Security</a>
        <span>/</span>
        <span class="text-foreground font-medium">Audit Logs</span>
      </nav>
      <h1 class="text-2xl font-bold tracking-tight text-foreground">Audit Logs</h1>
      <p class="text-sm text-muted-foreground">Immutable record of platform and administrative actions.</p>
    </div>

    <form method="get" class="flex flex-wrap items-center gap-3">
      <div class="relative flex-1 min-w-[200px] max-w-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-2.5 top-1/2 -translate-y-1/2 size-4 text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" name="q" value={searchQuery} placeholder="Search message, actor, event..." class="flex h-9 w-full rounded-lg border border-input bg-card pl-8 pr-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50" />
      </div>
      <select name="eventType" onchange="this.form.submit()" class="flex h-9 rounded-lg border border-input bg-card px-3 py-1.5 text-sm focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 max-w-[220px]">
        <option value="">All Actions</option>
        {EVENT_TYPES.map((t) => (
          <option value={t} selected={eventFilter === t}>{t}</option>
        ))}
      </select>
      <select name="actorType" onchange="this.form.submit()" class="flex h-9 rounded-lg border border-input bg-card px-3 py-1.5 text-sm focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
        <option value="">All Actors</option>
        <option value="admin" selected={actorFilter === "admin"}>Admins</option>
        <option value="user" selected={actorFilter === "user"}>Users</option>
        <option value="system" selected={actorFilter === "system"}>System</option>
      </select>
      <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-1.5 text-sm font-medium hover:bg-muted transition-colors h-9">
        Search
      </button>
    </form>

    <div class="flex flex-col xl:flex-row gap-6 items-start">
      <div class="rounded-xl border bg-card overflow-hidden flex-1 min-w-0 w-full">
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>Timestamp</TableHead>
            <TableHead>Actor</TableHead>
            <TableHead>Action</TableHead>
            <TableHead className="hidden lg:table-cell">Message</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {logs.map((log) => (
            <TableRow data-log-id={log.id} className="log-row cursor-pointer">
              <TableCell className="text-xs text-muted-foreground whitespace-nowrap">
                {new Date(log.occurredAt).toLocaleString()}
              </TableCell>
              <TableCell>
                <div class="flex items-center gap-2 min-w-0">
                  <span class="font-medium text-foreground truncate">
                    {log.actorName ?? log.adminId ?? log.userId ?? "System"}
                  </span>
                  <span class:list={[
                    "inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-medium capitalize shrink-0",
                    actorColor(log.actorType),
                  ]}>
                    {log.actorType}
                  </span>
                </div>
              </TableCell>
              <TableCell>
                <span class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-xs font-mono font-medium text-secondary-foreground">
                  {log.eventType}
                </span>
              </TableCell>
              <TableCell className="hidden lg:table-cell max-w-md">
                <p class="text-sm text-muted-foreground truncate">{log.message}</p>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
      {loadError && (
        <div class="px-4 py-12 text-center">
          <p class="text-sm text-destructive">{loadError}</p>
          <a href="/login" class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors mt-4">
            Sign in again
          </a>
        </div>
      )}
      {!loadError && logs.length === 0 && (
        <div class="px-4 py-12 text-center">
          <p class="text-sm font-medium text-foreground">No audit entries found</p>
          <p class="text-xs text-muted-foreground mt-1">Try adjusting your search or filters.</p>
        </div>
      )}
      {!loadError && (
        <Pagination page={page} totalPages={totalPages} total={total} basePath="/security/audit-logs" params={pageParams} />
      )}
      </div>

      <aside id="log-panel" class="w-full xl:w-96 shrink-0 xl:sticky xl:top-6 rounded-xl border bg-card overflow-hidden">
        <div id="log-panel-empty" class="px-5 py-12 text-center">
          <p class="text-sm font-medium text-foreground">No entry selected</p>
          <p class="text-xs text-muted-foreground mt-1">Click a row to inspect its details here.</p>
        </div>
        <div id="log-panel-detail" class="hidden">
          <div class="flex items-start justify-between gap-2 p-5 border-b border-border">
            <div class="min-w-0">
              <span id="log-panel-event" class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-xs font-mono font-medium text-secondary-foreground"></span>
              <p id="log-panel-time" class="text-xs text-muted-foreground mt-1.5"></p>
            </div>
            <button
              type="button"
              id="log-panel-close"
              aria-label="Close details"
              class="rounded-md p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground shrink-0"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
          <div class="p-5 space-y-4 max-h-[60vh] overflow-y-auto">
            <div>
              <p class="text-xs font-medium text-muted-foreground mb-1">Message</p>
              <p id="log-panel-message" class="text-sm text-foreground whitespace-pre-wrap"></p>
            </div>
            <div>
              <p class="text-xs font-medium text-muted-foreground mb-1">Actor</p>
              <p id="log-panel-actor" class="text-sm text-foreground"></p>
            </div>
            <dl id="log-panel-ids" class="space-y-1.5 text-xs"></dl>
            <div id="log-panel-meta-wrap" class="hidden">
              <p class="text-xs font-medium text-muted-foreground mb-1">Metadata</p>
              <pre id="log-panel-meta" class="overflow-x-auto rounded-lg border border-border bg-background p-3 font-mono text-xs text-foreground"></pre>
            </div>
          </div>
        </div>
      </aside>
    </div>
    <script type="application/json" id="log-data" set:html={JSON.stringify(Object.fromEntries(logs.map((l) => [l.id, l])))} />
  </div>
</AdminLayout>

<script>
  const store: Record<string, any> = JSON.parse(
    document.getElementById("log-data")?.textContent ?? "{}",
  );
  const emptyEl = document.getElementById("log-panel-empty")!;
  const detailEl = document.getElementById("log-panel-detail")!;
  const eventEl = document.getElementById("log-panel-event")!;
  const timeEl = document.getElementById("log-panel-time")!;
  const messageEl = document.getElementById("log-panel-message")!;
  const actorEl = document.getElementById("log-panel-actor")!;
  const idsEl = document.getElementById("log-panel-ids")!;
  const metaWrap = document.getElementById("log-panel-meta-wrap")!;
  const metaEl = document.getElementById("log-panel-meta")!;
  let activeRow: HTMLTableRowElement | null = null;

  function idRow(label: string, value: string) {
    const div = document.createElement("div");
    div.className = "flex gap-2";
    const dt = document.createElement("dt");
    dt.className = "text-muted-foreground shrink-0";
    dt.textContent = label;
    const dd = document.createElement("dd");
    dd.className = "font-mono text-foreground break-all";
    dd.textContent = value;
    div.append(dt, dd);
    return div;
  }

  function selectRow(row: HTMLTableRowElement | null) {
    activeRow?.classList.remove("bg-muted");
    activeRow = row;
    if (!row) {
      detailEl.classList.add("hidden");
      emptyEl.classList.remove("hidden");
      return;
    }
    const log = store[row.dataset.logId ?? ""];
    if (!log) return;
    row.classList.add("bg-muted");
    eventEl.textContent = log.eventType ?? "";
    timeEl.textContent = log.occurredAt ? new Date(log.occurredAt).toLocaleString() : "";
    messageEl.textContent = log.message ?? "";
    actorEl.textContent =
      log.actorName ?? log.adminId ?? log.userId ?? `System (${log.actorType})`;
    idsEl.replaceChildren();
    idsEl.append(idRow("Entry ID:", log.id ?? ""));
    if (log.adminId) idsEl.append(idRow("Admin ID:", log.adminId));
    if (log.userId) idsEl.append(idRow("User ID:", log.userId));
    if (log.projectId) idsEl.append(idRow("Project ID:", log.projectId));
    const meta = log.metadata;
    if (meta && Object.keys(meta).length > 0) {
      metaEl.textContent = JSON.stringify(meta, null, 2);
      metaWrap.classList.remove("hidden");
    } else {
      metaWrap.classList.add("hidden");
    }
    emptyEl.classList.add("hidden");
    detailEl.classList.remove("hidden");
  }

  document.querySelectorAll<HTMLTableRowElement>("tr.log-row").forEach((row) => {
    row.addEventListener("click", () => selectRow(row === activeRow ? null : row));
  });

  document.getElementById("log-panel-close")?.addEventListener("click", () => selectRow(null));
</script>
