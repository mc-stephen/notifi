---
import AdminLayout from "../../layouts/AdminLayout.astro";

const admins = [
  { id: "1", name: "Admin User", email: "admin@notifi.dev", role: "Super Admin", status: "active", lastLogin: "2025-09-04T08:00:00Z" },
  { id: "2", name: "Support Lead", email: "support@notifi.dev", role: "Support Admin", status: "active", lastLogin: "2025-09-04T07:30:00Z" },
  { id: "3", name: "Billing Admin", email: "billing@notifi.dev", role: "Billing Admin", status: "active", lastLogin: "2025-09-03T14:00:00Z" },
];
---

<AdminLayout title="Admins">
  <div class="space-y-6">
    <div class="space-y-1">
      <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
        <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
        <span>/</span>
        <a href="/administration" class="hover:text-foreground transition-colors">Administration</a>
        <span>/</span>
        <span class="text-foreground font-medium">Admins</span>
      </nav>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-foreground">Admin Users</h1>
          <p class="text-sm text-muted-foreground mt-1">Manage administrator accounts and roles.</p>
        </div>
        <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          Add Admin
        </button>
      </div>
    </div>

    <div class="rounded-xl border bg-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/30">
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Admin</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Role</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Status</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden md:table-cell">Last Login</th>
              <th class="text-right py-3 px-4 font-medium text-muted-foreground"></th>
            </tr>
          </thead>
          <tbody>
            {admins.map((admin) => (
              <tr class="border-b border-border/50 last:border-0 hover:bg-muted/50 transition-colors">
                <td class="py-3 px-4">
                  <div class="flex items-center gap-3">
                    <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-medium text-primary">
                      {admin.name.split(" ").map(n => n[0]).join("")}
                    </div>
                    <div>
                      <p class="font-medium text-foreground">{admin.name}</p>
                      <p class="text-xs text-muted-foreground">{admin.email}</p>
                    </div>
                  </div>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">
                    {admin.role}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium bg-success/10 text-success border-success/20 capitalize">
                    {admin.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-muted-foreground text-xs hidden md:table-cell">
                  {new Date(admin.lastLogin).toLocaleString()}
                </td>
                <td class="py-3 px-4 text-right">
                  <button class="text-xs text-muted-foreground hover:text-foreground transition-colors">Edit</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
