---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Settings">
  <div class="space-y-6">
    <div class="space-y-1">
      <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
        <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
        <span>/</span>
        <a href="/administration" class="hover:text-foreground transition-colors">Administration</a>
        <span>/</span>
        <span class="text-foreground font-medium">Settings</span>
      </nav>
      <h1 class="text-2xl font-bold tracking-tight text-foreground">Platform Settings</h1>
      <p class="text-sm text-muted-foreground">Configure platform-wide settings and preferences.</p>
    </div>

    <div class="space-y-6">
      <!-- General -->
      <div class="rounded-xl border bg-card">
        <div class="p-5 border-b border-border">
          <h2 class="font-semibold text-foreground">General</h2>
          <p class="text-sm text-muted-foreground mt-0.5">Basic platform configuration</p>
        </div>
        <div class="p-5 space-y-4">
          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Platform Name</label>
            <input type="text" value="Notifi" class="flex h-9 w-full max-w-md rounded-lg border border-input bg-transparent px-3 py-1.5 text-sm shadow-xs transition-colors focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50" />
          </div>
          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Support Email</label>
            <input type="email" value="support@notifi.dev" class="flex h-9 w-full max-w-md rounded-lg border border-input bg-transparent px-3 py-1.5 text-sm shadow-xs transition-colors focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50" />
          </div>
        </div>
      </div>

      <!-- Notifications -->
      <div class="rounded-xl border bg-card">
        <div class="p-5 border-b border-border">
          <h2 class="font-semibold text-foreground">Notification Defaults</h2>
          <p class="text-sm text-muted-foreground mt-0.5">Default settings for new projects</p>
        </div>
        <div class="p-5 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-foreground">Email Notifications</p>
              <p class="text-xs text-muted-foreground">Enable email channel by default</p>
            </div>
            <button class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-primary transition-colors" role="switch" aria-checked="true">
              <span class="pointer-events-none block size-4 rounded-full bg-background shadow-lg ring-0 translate-x-4"></span>
            </button>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-foreground">Push Notifications</p>
              <p class="text-xs text-muted-foreground">Enable push channel by default</p>
            </div>
            <button class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-primary transition-colors" role="switch" aria-checked="true">
              <span class="pointer-events-none block size-4 rounded-full bg-background shadow-lg ring-0 translate-x-4"></span>
            </button>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-foreground">SMS Notifications</p>
              <p class="text-xs text-muted-foreground">Enable SMS channel by default</p>
            </div>
            <button class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-muted transition-colors" role="switch" aria-checked="false">
              <span class="pointer-events-none block size-4 rounded-full bg-background shadow-lg ring-0 translate-x-0"></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Security -->
      <div class="rounded-xl border bg-card">
        <div class="p-5 border-b border-border">
          <h2 class="font-semibold text-foreground">Security</h2>
          <p class="text-sm text-muted-foreground mt-0.5">Admin security settings</p>
        </div>
        <div class="p-5 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-foreground">Require 2FA for Admins</p>
              <p class="text-xs text-muted-foreground">Enforce two-factor authentication</p>
            </div>
            <button class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-primary transition-colors" role="switch" aria-checked="true">
              <span class="pointer-events-none block size-4 rounded-full bg-background shadow-lg ring-0 translate-x-4"></span>
            </button>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-foreground">Session Timeout</p>
              <p class="text-xs text-muted-foreground">Auto-logout after inactivity</p>
            </div>
            <select class="flex h-9 rounded-lg border border-input bg-transparent px-3 py-1.5 text-sm shadow-xs focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
              <option value="30">30 minutes</option>
              <option value="60" selected>1 hour</option>
              <option value="120">2 hours</option>
              <option value="480">8 hours</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Change Password -->
      <div class="rounded-xl border bg-card">
        <div class="p-5 border-b border-border">
          <h2 class="font-semibold text-foreground">Change Password</h2>
          <p class="text-sm text-muted-foreground mt-0.5">Rotate your own sign-in password</p>
        </div>
        <form id="password-form" class="p-5 space-y-4">
          <div class="space-y-2">
            <label for="current-password" class="text-sm font-medium text-foreground">Current Password</label>
            <input
              type="password"
              id="current-password"
              required
              autocomplete="current-password"
              placeholder="Enter current password"
              class="flex h-9 w-full max-w-md rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
            />
          </div>
          <div class="space-y-2">
            <label for="new-password" class="text-sm font-medium text-foreground">New Password</label>
            <input
              type="password"
              id="new-password"
              required
              autocomplete="new-password"
              placeholder="At least 8 characters"
              class="flex h-9 w-full max-w-md rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
            />
            <p class="text-xs text-muted-foreground">Minimum 8 characters. Must include uppercase, lowercase, number, and special character.</p>
          </div>
          <div class="space-y-2">
            <label for="confirm-password" class="text-sm font-medium text-foreground">Confirm New Password</label>
            <input
              type="password"
              id="confirm-password"
              required
              autocomplete="new-password"
              placeholder="Repeat new password"
              class="flex h-9 w-full max-w-md rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
            />
          </div>

          <div id="password-error" class="hidden max-w-md rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive"></div>
          <div id="password-success" class="hidden max-w-md rounded-lg border border-success/20 bg-success/5 p-3 text-sm text-success">
            Password changed. Your other sessions were signed out.
          </div>

          <button
            type="submit"
            id="password-btn"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 disabled:pointer-events-none disabled:opacity-50"
          >
            <span id="password-btn-text">Change Password</span>
            <svg id="password-btn-spinner" class="hidden size-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </button>
        </form>
      </div>

      <div class="flex justify-end">
        <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80">
          Save Settings
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { auth, ApiError } from "../../lib/api";
  import { passwordValid } from "../../lib/password";

  const form = document.getElementById("password-form") as HTMLFormElement;
  const currentInput = document.getElementById("current-password") as HTMLInputElement;
  const newInput = document.getElementById("new-password") as HTMLInputElement;
  const confirmInput = document.getElementById("confirm-password") as HTMLInputElement;
  const errorDiv = document.getElementById("password-error");
  const successDiv = document.getElementById("password-success");
  const submitBtn = document.getElementById("password-btn") as HTMLButtonElement;
  const btnText = document.getElementById("password-btn-text");
  const btnSpinner = document.getElementById("password-btn-spinner");

  function showError(message: string) {
    if (!errorDiv) return;
    errorDiv.textContent = message;
    errorDiv.classList.remove("hidden");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorDiv?.classList.add("hidden");
    successDiv?.classList.add("hidden");

    if (!passwordValid(newInput.value)) {
      showError("New password must be at least 8 characters and include an uppercase letter, a lowercase letter, a number, and a special character.");
      return;
    }
    if (newInput.value !== confirmInput.value) {
      showError("New passwords do not match.");
      return;
    }

    btnText && (btnText.textContent = "");
    btnSpinner?.classList.remove("hidden");
    submitBtn.disabled = true;

    try {
      await auth.changePassword(currentInput.value, newInput.value);
      successDiv?.classList.remove("hidden");
      form.reset();
    } catch (err) {
      showError(err instanceof ApiError ? err.message : "Password change failed. Please try again.");
    } finally {
      btnSpinner?.classList.add("hidden");
      submitBtn.disabled = false;
      btnText && (btnText.textContent = "Change Password");
    }
  });
</script>
