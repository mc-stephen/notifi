---
import AdminLayout from "../../layouts/AdminLayout.astro";
import type { AdminProjectDetail } from "../../lib/types";

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";
const session = Astro.cookies.get("admin_session")?.value;
const cookieHeader = session ? { Cookie: `admin_session=${session}` } : {};

const { id } = Astro.params;

let project: AdminProjectDetail | null = null;
let loadError: string | null = null;
try {
  const res = await fetch(`${API_BASE}/admin/projects/${encodeURIComponent(id ?? "")}`, {
    headers: cookieHeader,
  });
  if (res.status === 401) {
    Astro.response.status = 401;
    loadError = "Your session has expired. Please sign out and sign in again.";
  } else if (res.status === 404) {
    Astro.response.status = 404;
  } else {
    if (!res.ok) throw new Error(`Project request failed (${res.status})`);
    project = (await res.json()).project;
  }
} catch {
  Astro.response.status = 500;
  loadError = loadError ?? "Could not load this project. Check that the API is running and try again.";
}

function initials(name: string) {
  return name
    .split(" ")
    .map((n) => n[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
}
---

<AdminLayout title={project ? `Project: ${project.name}` : "Project not found"}>
  <div class="space-y-6">
    <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
      <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
      <span>/</span>
      <a href="/projects" class="hover:text-foreground transition-colors">Projects</a>
      <span>/</span>
      <span class="text-foreground font-medium">{project?.name ?? id}</span>
    </nav>

    {!project ? (
      <div class="rounded-xl border bg-card px-4 py-12 text-center">
        <p class="text-sm font-medium text-foreground">{loadError ? "Something went wrong" : "Project not found"}</p>
        <p class="text-xs text-muted-foreground mt-1">{loadError ?? "It may have been deleted, or the link is wrong."}</p>
        <a href={loadError ? "/login" : "/projects"} class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors mt-4">
          {loadError ? "Sign in again" : "Back to projects"}
        </a>
      </div>
    ) : (
      <>
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center text-base font-medium text-primary shrink-0">
              {initials(project.name)}
            </div>
            <div>
              <h1 class="text-2xl font-bold tracking-tight text-foreground">{project.name}</h1>
              <p class="text-sm text-muted-foreground mt-0.5">{project.slug}</p>
            </div>
          </div>
          <span class:list={[
            "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium capitalize shrink-0",
            project.environment === "production"
              ? "bg-success/10 text-success border-success/20"
              : "bg-muted text-muted-foreground border-border",
          ]}>
            {project.environment}
          </span>
        </div>

        {project.description && (
          <p class="text-sm text-muted-foreground whitespace-pre-wrap">{project.description}</p>
        )}

        <div class="max-w-3xl space-y-6">
          <div class="space-y-6">
            <div class="rounded-xl border bg-card">
              <div class="p-5 border-b border-border">
                <h2 class="font-semibold text-foreground">Overview</h2>
              </div>
              <div class="p-5 grid grid-cols-2 gap-x-4 gap-y-4">
                <div>
                  <p class="text-xs text-muted-foreground">Owner</p>
                  <p class="text-sm font-medium text-foreground mt-1">{project.ownerName ?? "—"}</p>
                  {project.ownerEmail && (
                    <p class="text-xs text-muted-foreground mt-0.5 break-all">{project.ownerEmail}</p>
                  )}
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Members</p>
                  <p class="text-sm font-medium text-foreground mt-1">{project.memberCount}</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Created</p>
                  <p class="text-sm font-medium text-foreground mt-1">{new Date(project.createdAt).toLocaleDateString()}</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Updated</p>
                  <p class="text-sm font-medium text-foreground mt-1">{new Date(project.updatedAt).toLocaleDateString()}</p>
                </div>
              </div>
            </div>

            <div class="rounded-xl border bg-card">
              <div class="p-5 border-b border-border">
                <h2 class="font-semibold text-foreground">Members ({project.members.length})</h2>
              </div>
              {project.members.length > 0 ? (
                <ul class="divide-y divide-border/50">
                  {project.members.map((member) => (
                    <li class="flex items-center gap-3 px-5 py-3">
                      <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-medium text-primary shrink-0">
                        {initials(member.name ?? member.email ?? "?")}
                      </div>
                      <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium text-foreground truncate">{member.name ?? "Unknown"}</p>
                        <p class="text-xs text-muted-foreground truncate">{member.email ?? member.userId}</p>
                      </div>
                      <span class="inline-flex items-center rounded-md border border-border bg-muted/50 px-2 py-0.5 text-xs font-medium capitalize text-muted-foreground shrink-0">
                        {member.role}
                      </span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-sm text-muted-foreground text-center px-5 py-8">No members yet.</p>
              )}
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</AdminLayout>
