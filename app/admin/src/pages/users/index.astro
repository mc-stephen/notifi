---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { mockUsers } from "../../data/users";
---

<AdminLayout title="Users">
  <div class="space-y-6">
    <div class="flex items-start justify-between gap-4">
      <div class="space-y-1">
        <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
          <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
          <span>/</span>
          <span class="text-foreground font-medium">Users</span>
        </nav>
        <h1 class="text-2xl font-bold tracking-tight text-foreground">Users</h1>
        <p class="text-sm text-muted-foreground">Manage platform users and their accounts.</p>
      </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap items-center gap-3">
      <div class="relative flex-1 min-w-[200px] max-w-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-2.5 top-1/2 -translate-y-1/2 size-4 text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" placeholder="Search users..." class="flex h-9 w-full rounded-lg border border-input bg-transparent pl-8 pr-3 py-1.5 text-sm shadow-xs transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50" />
      </div>
      <select class="flex h-9 rounded-lg border border-input bg-transparent px-3 py-1.5 text-sm shadow-xs focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="suspended">Suspended</option>
        <option value="banned">Banned</option>
        <option value="restricted">Restricted</option>
      </select>
      <select class="flex h-9 rounded-lg border border-input bg-transparent px-3 py-1.5 text-sm shadow-xs focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
        <option value="">All Plans</option>
        <option value="free">Free</option>
        <option value="starter">Starter</option>
        <option value="pro">Pro</option>
        <option value="enterprise">Enterprise</option>
      </select>
    </div>

    <!-- Table -->
    <div class="rounded-xl border bg-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/30">
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">User</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Status</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Organization</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Plan</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden md:table-cell">Notifications</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden lg:table-cell">Last Active</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden lg:table-cell">Billing</th>
              <th class="text-right py-3 px-4 font-medium text-muted-foreground"></th>
            </tr>
          </thead>
          <tbody>
            {mockUsers.map((user) => (
              <tr class="border-b border-border/50 last:border-0 hover:bg-muted/50 transition-colors">
                <td class="py-3 px-4">
                  <div class="flex items-center gap-3">
                    <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-medium text-primary shrink-0">
                      {user.name.split(" ").map(n => n[0]).join("")}
                    </div>
                    <div class="min-w-0">
                      <a href={`/users/${user.id}`} class="font-medium text-foreground hover:underline block truncate">
                        {user.name}
                      </a>
                      <p class="text-xs text-muted-foreground truncate">{user.email}</p>
                    </div>
                  </div>
                </td>
                <td class="py-3 px-4">
                  <span class:list={[
                    "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                    user.status === "active" && "bg-success/10 text-success border-success/20",
                    user.status === "suspended" && "bg-destructive/10 text-destructive border-destructive/20",
                    user.status === "banned" && "bg-destructive/10 text-destructive border-destructive/20",
                    user.status === "restricted" && "bg-warning/10 text-warning border-warning/20",
                    user.status === "deleted" && "bg-muted text-muted-foreground border-border",
                  ]}>
                    {user.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-foreground">{user.organization || "—"}</td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground capitalize">
                    {user.plan}
                  </span>
                </td>
                <td class="py-3 px-4 text-foreground hidden md:table-cell">{user.notificationCount.toLocaleString()}</td>
                <td class="py-3 px-4 text-muted-foreground text-xs hidden lg:table-cell">
                  {new Date(user.lastActiveAt).toLocaleDateString()}
                </td>
                <td class="py-3 px-4 hidden lg:table-cell">
                  <span class:list={[
                    "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                    user.billingStatus === "current" && "bg-success/10 text-success border-success/20",
                    user.billingStatus === "past_due" && "bg-warning/10 text-warning border-warning/20",
                    user.billingStatus === "cancelled" && "bg-destructive/10 text-destructive border-destructive/20",
                  ]}>
                    {user.billingStatus.replace("_", " ")}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <a href={`/users/${user.id}`} class="text-xs text-primary hover:underline">View</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <!-- Pagination -->
      <div class="flex items-center justify-between px-4 py-3 border-t border-border">
        <p class="text-xs text-muted-foreground">Showing 1-10 of {mockUsers.length} users</p>
        <div class="flex items-center gap-1">
          <button class="inline-flex items-center justify-center h-7 px-2.5 rounded-md text-xs font-medium border border-border bg-background hover:bg-muted transition-colors disabled:opacity-50" disabled>
            Previous
          </button>
          <button class="inline-flex items-center justify-center h-7 w-7 rounded-md text-xs font-medium bg-primary text-primary-foreground">
            1
          </button>
          <button class="inline-flex items-center justify-center h-7 px-2.5 rounded-md text-xs font-medium border border-border bg-background hover:bg-muted transition-colors disabled:opacity-50" disabled>
            Next
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
