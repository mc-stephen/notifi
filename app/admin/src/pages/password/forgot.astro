---
import AuthLayout from "../../layouts/AuthLayout.astro";
---

<AuthLayout title="Forgot Password">
  <div class="space-y-6">
    <div class="space-y-2 text-center">
      <h1 class="text-2xl font-bold text-foreground">Reset your password</h1>
      <p class="text-sm text-muted-foreground">
        Enter your email address and we'll send you a link to reset your password.
      </p>
    </div>

    <form id="forgot-form" class="space-y-4">
      <div class="space-y-2">
        <label for="email" class="text-sm font-medium text-foreground">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="admin@notifi.dev"
          class="flex h-9 w-full rounded-lg border border-input bg-transparent px-3 py-1.5 text-sm shadow-xs transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50"
        />
      </div>

      <div id="error-message" class="hidden rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive">
        Unable to process request. Please try again.
      </div>

      <div id="success-message" class="hidden rounded-lg border border-success/20 bg-success/5 p-3 text-sm text-success">
        If an account exists with that email, you'll receive a password reset link shortly.
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 w-full"
      >
        <span id="btn-text">Send Reset Link</span>
        <svg id="btn-spinner" class="hidden size-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </button>
    </form>

    <div class="text-center">
      <a href="/login" class="text-sm text-primary hover:underline">
        ← Back to sign in
      </a>
    </div>
  </div>
</AuthLayout>

<script>
  const form = document.getElementById("forgot-form") as HTMLFormElement;
  const errorDiv = document.getElementById("error-message");
  const successDiv = document.getElementById("success-message");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text");
  const btnSpinner = document.getElementById("btn-spinner");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    errorDiv?.classList.add("hidden");
    successDiv?.classList.add("hidden");
    btnText && (btnText.textContent = "");
    btnSpinner?.classList.remove("hidden");
    submitBtn.disabled = true;

    setTimeout(() => {
      btnSpinner?.classList.add("hidden");
      submitBtn.disabled = false;
      successDiv?.classList.remove("hidden");
      btnText && (btnText.textContent = "Send Reset Link");
    }, 1500);
  });
</script>
