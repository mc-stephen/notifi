---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { mockPayments } from "../../data/billing";
---

<AdminLayout title="Payments">
  <div class="space-y-6">
    <div class="space-y-1">
      <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
        <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
        <span>/</span>
        <a href="/billing" class="hover:text-foreground transition-colors">Billing</a>
        <span>/</span>
        <span class="text-foreground font-medium">Payments</span>
      </nav>
      <h1 class="text-2xl font-bold tracking-tight text-foreground">Payments</h1>
      <p class="text-sm text-muted-foreground">Track payment history and failed payments.</p>
    </div>

    <div class="rounded-xl border bg-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/30">
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Customer</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Amount</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Status</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden md:table-cell">Method</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden lg:table-cell">Date</th>
            </tr>
          </thead>
          <tbody>
            {mockPayments.map((pay) => (
              <tr class="border-b border-border/50 last:border-0 hover:bg-muted/50 transition-colors">
                <td class="py-3 px-4 font-medium text-foreground">{pay.customerName}</td>
                <td class="py-3 px-4 text-foreground">${pay.amount}</td>
                <td class="py-3 px-4">
                  <span class:list={[
                    "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                    pay.status === "succeeded" && "bg-success/10 text-success border-success/20",
                    pay.status === "failed" && "bg-destructive/10 text-destructive border-destructive/20",
                    pay.status === "pending" && "bg-warning/10 text-warning border-warning/20",
                    pay.status === "refunded" && "bg-info/10 text-info border-info/20",
                  ]}>
                    {pay.status}
                  </span>
                  {pay.failureReason && (
                    <p class="text-xs text-destructive mt-1">{pay.failureReason}</p>
                  )}
                </td>
                <td class="py-3 px-4 text-muted-foreground hidden md:table-cell">{pay.paymentMethod}</td>
                <td class="py-3 px-4 text-muted-foreground text-xs hidden lg:table-cell">
                  {new Date(pay.createdAt).toLocaleDateString()}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
