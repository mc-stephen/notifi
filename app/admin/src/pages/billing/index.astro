---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { mockSubscriptions, mockPayments, mockInvoices } from "../../data/billing";
---

<AdminLayout title="Billing">
  <div class="space-y-6">
    <div class="space-y-1">
      <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
        <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
        <span>/</span>
        <span class="text-foreground font-medium">Billing</span>
      </nav>
      <h1 class="text-2xl font-bold tracking-tight text-foreground">Billing</h1>
      <p class="text-sm text-muted-foreground">Monitor revenue, subscriptions, and payment activity.</p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded-xl border bg-card p-4">
        <p class="text-sm text-muted-foreground">MRR</p>
        <p class="text-2xl font-bold text-foreground mt-1">$627</p>
        <p class="text-xs text-success mt-1">+12.5%</p>
      </div>
      <div class="rounded-xl border bg-card p-4">
        <p class="text-sm text-muted-foreground">Active Subscriptions</p>
        <p class="text-2xl font-bold text-foreground mt-1">{mockSubscriptions.filter(s => s.status === "active").length}</p>
      </div>
      <div class="rounded-xl border bg-card p-4">
        <p class="text-sm text-muted-foreground">Failed Payments</p>
        <p class="text-2xl font-bold text-foreground mt-1">{mockPayments.filter(p => p.status === "failed").length}</p>
      </div>
      <div class="rounded-xl border bg-card p-4">
        <p class="text-sm text-muted-foreground">Past Due</p>
        <p class="text-2xl font-bold text-foreground mt-1">{mockSubscriptions.filter(s => s.status === "past_due").length}</p>
      </div>
    </div>

    <!-- Subscriptions -->
    <div class="rounded-xl border bg-card overflow-hidden">
      <div class="p-5 border-b border-border">
        <h2 class="font-semibold text-foreground">Subscriptions</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/30">
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Customer</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Plan</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Status</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden md:table-cell">Amount</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden lg:table-cell">Usage</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden lg:table-cell">Renewal</th>
            </tr>
          </thead>
          <tbody>
            {mockSubscriptions.map((sub) => (
              <tr class="border-b border-border/50 last:border-0 hover:bg-muted/50 transition-colors">
                <td class="py-3 px-4">
                  <p class="font-medium text-foreground">{sub.customerName}</p>
                  <p class="text-xs text-muted-foreground">{sub.customerEmail}</p>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">{sub.plan}</span>
                </td>
                <td class="py-3 px-4">
                  <span class:list={[
                    "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                    sub.status === "active" && "bg-success/10 text-success border-success/20",
                    sub.status === "past_due" && "bg-warning/10 text-warning border-warning/20",
                    sub.status === "cancelled" && "bg-destructive/10 text-destructive border-destructive/20",
                  ]}>
                    {sub.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-foreground hidden md:table-cell">${sub.amount}/{sub.currency === "USD" ? "mo" : sub.currency}</td>
                <td class="py-3 px-4 hidden lg:table-cell">
                  <div class="flex items-center gap-2">
                    <div class="h-1.5 w-16 rounded-full bg-muted overflow-hidden">
                      <div class:list={[
                        "h-full rounded-full",
                        sub.usagePercent > 80 ? "bg-destructive" : sub.usagePercent > 50 ? "bg-warning" : "bg-success",
                      ]} style={`width: ${sub.usagePercent}%`}></div>
                    </div>
                    <span class="text-xs text-muted-foreground">{sub.usagePercent}%</span>
                  </div>
                </td>
                <td class="py-3 px-4 text-muted-foreground text-xs hidden lg:table-cell">
                  {new Date(sub.renewalDate).toLocaleDateString()}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent Payments -->
    <div class="rounded-xl border bg-card overflow-hidden">
      <div class="p-5 border-b border-border">
        <h2 class="font-semibold text-foreground">Recent Payments</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/30">
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Customer</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Amount</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground">Status</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden md:table-cell">Method</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground hidden lg:table-cell">Date</th>
            </tr>
          </thead>
          <tbody>
            {mockPayments.map((pay) => (
              <tr class="border-b border-border/50 last:border-0 hover:bg-muted/50 transition-colors">
                <td class="py-3 px-4 font-medium text-foreground">{pay.customerName}</td>
                <td class="py-3 px-4 text-foreground">${pay.amount}</td>
                <td class="py-3 px-4">
                  <span class:list={[
                    "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                    pay.status === "succeeded" && "bg-success/10 text-success border-success/20",
                    pay.status === "failed" && "bg-destructive/10 text-destructive border-destructive/20",
                    pay.status === "pending" && "bg-warning/10 text-warning border-warning/20",
                    pay.status === "refunded" && "bg-info/10 text-info border-info/20",
                  ]}>
                    {pay.status}
                  </span>
                  {pay.failureReason && (
                    <p class="text-xs text-destructive mt-1">{pay.failureReason}</p>
                  )}
                </td>
                <td class="py-3 px-4 text-muted-foreground hidden md:table-cell">{pay.paymentMethod}</td>
                <td class="py-3 px-4 text-muted-foreground text-xs hidden lg:table-cell">
                  {new Date(pay.createdAt).toLocaleDateString()}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
