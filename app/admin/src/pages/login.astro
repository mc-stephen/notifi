---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Sign In">
  <div class="space-y-6">
    <div class="space-y-3 text-center">
      <div class="flex justify-center">
        <div class="size-11 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
      </div>
      <div class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight text-foreground">Sign in to Admin</h1>
        <p class="text-sm text-muted-foreground">
          Enter your credentials to access the admin dashboard.
        </p>
      </div>
    </div>

    <form id="login-form" class="space-y-4">
      <div class="space-y-2">
        <label for="email" class="text-sm font-medium text-foreground">Email</label>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground pointer-events-none"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="admin@notifi.dev"
            class="flex h-10 w-full rounded-lg border border-input bg-card pl-9 pr-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          />
        </div>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="password" class="text-sm font-medium text-foreground">Password</label>
          <a href="/password/forgot" class="text-xs text-primary hover:underline">Forgot password?</a>
        </div>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground pointer-events-none"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="Enter your password"
            class="flex h-10 w-full rounded-lg border border-input bg-card pl-9 pr-10 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          />
          <button
            type="button"
            id="toggle-password"
            class="absolute right-2 top-1/2 -translate-y-1/2 p-1 rounded text-muted-foreground hover:text-foreground transition-colors"
            aria-label="Toggle password visibility"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="eye-icon"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div id="totp-group" class="hidden space-y-2">
        <label for="totp-code" class="text-sm font-medium text-foreground">Two-Factor Code</label>
        <input
          type="text"
          id="totp-code"
          name="totp-code"
          autocomplete="one-time-code"
          inputmode="numeric"
          maxlength="6"
          pattern="[0-9]{6}"
          placeholder="000000"
          class="flex h-9 w-full rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 text-center tracking-[0.5em] font-mono"
        />
        <div class="flex items-center justify-between">
          <p class="text-xs text-muted-foreground">Enter the 6-digit code from your authenticator app.</p>
          <button type="button" id="cancel-totp" class="text-xs text-primary hover:underline">Cancel</button>
        </div>
      </div>

      <div id="info-message" class="hidden rounded-lg border border-primary/20 bg-primary/5 p-3 text-sm text-primary"></div>

      <div id="error-message" class="hidden rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive"></div>

      <button
        type="submit"
        id="submit-btn"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 w-full"
      >
        <span id="btn-text">Sign In</span>
        <svg id="btn-spinner" class="hidden size-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </button>
    </form>

    <div class="text-center">
      <p class="text-xs text-muted-foreground">
        Authorized administrators only. Public registration is not available.
      </p>
    </div>
  </div>
</AuthLayout>

<script>
  import { auth, ApiError } from "../lib/api";

  // Password toggle
  const toggleBtn = document.getElementById("toggle-password");
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const eyeIcon = document.getElementById("eye-icon");
  let showPassword = false;

  toggleBtn?.addEventListener("click", () => {
    showPassword = !showPassword;
    passwordInput.type = showPassword ? "text" : "password";
    if (eyeIcon) {
      eyeIcon.innerHTML = showPassword
        ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" x2="23" y1="1" y2="23"/>'
        : '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
    }
  });

  // Login form
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const totpGroup = document.getElementById("totp-group")!;
  const infoDiv = document.getElementById("info-message")!;
  const errorDiv = document.getElementById("error-message")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text")!;
  const btnSpinner = document.getElementById("btn-spinner")!;
  const totpInput = document.getElementById("totp-code") as HTMLInputElement;
  const cancelTotp = document.getElementById("cancel-totp")!;

  function showInfo(message: string) {
    infoDiv.textContent = message;
    infoDiv.classList.remove("hidden");
  }

  function showError(message: string) {
    errorDiv.textContent = message;
    errorDiv.classList.remove("hidden");
  }

  // Cancel clears any partial session (e.g. after requires_totp_setup) and
  // returns to a clean login form.
  cancelTotp?.addEventListener("click", async () => {
    try {
      await auth.logout();
    } catch {
      // Best-effort: the form reset below matters, not the server call.
    }
    window.location.reload();
  });

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorDiv.classList.add("hidden");
    infoDiv.classList.add("hidden");
    btnText.textContent = "";
    btnSpinner.classList.remove("hidden");
    submitBtn.disabled = true;

    const email = (document.getElementById("email") as HTMLInputElement).value;
    const password = (document.getElementById("password") as HTMLInputElement).value;
    const totpCode = totpInput?.value || undefined;

    try {
      const data = await auth.login({ email, password, totp_code: totpCode });

      if (data.requires_totp_setup) {
        window.location.href = "/auth/totp";
        return;
      }

      if (data.requires_totp) {
        totpGroup.classList.remove("hidden");
        totpInput.focus();
        showInfo("Password accepted. Enter the 6-digit code from your authenticator app to finish signing in.");
      } else {
        window.location.href = "/overview";
      }
    } catch (err) {
      showError(err instanceof ApiError ? err.message : "Login failed");
    } finally {
      btnText.textContent = "Sign In";
      btnSpinner.classList.add("hidden");
      submitBtn.disabled = false;
    }
  });
</script>
