---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { mockSystemHealth, mockProviders } from "../../data/platform";
---

<AdminLayout title="System Health">
  <div class="space-y-6">
    <div class="space-y-1">
      <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
        <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
        <span>/</span>
        <a href="/platform" class="hover:text-foreground transition-colors">Platform</a>
        <span>/</span>
        <span class="text-foreground font-medium">Health</span>
      </nav>
      <h1 class="text-2xl font-bold tracking-tight text-foreground">System Health</h1>
      <p class="text-sm text-muted-foreground">Monitor platform infrastructure and service status.</p>
    </div>

    <!-- System Services -->
    <div class="rounded-xl border bg-card">
      <div class="p-5 border-b border-border">
        <h2 class="font-semibold text-foreground">Services</h2>
      </div>
      <div class="p-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {mockSystemHealth.map((item) => (
            <div class="rounded-lg border border-border/50 p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-foreground">{item.service}</span>
                <span class:list={[
                  "text-xs font-medium capitalize",
                  item.status === "operational" ? "text-success" : "",
                  item.status === "degraded" ? "text-warning" : "",
                  item.status === "down" ? "text-destructive" : "",
                ]}>
                  {item.status}
                </span>
              </div>
              {item.latencyMs !== undefined && (
                <p class="text-xs text-muted-foreground">Latency: {item.latencyMs}ms</p>
              )}
              <p class="text-xs text-muted-foreground mt-1">Last check: {new Date(item.lastCheck).toLocaleTimeString()}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Providers -->
    <div class="rounded-xl border bg-card">
      <div class="p-5 border-b border-border">
        <h2 class="font-semibold text-foreground">Notification Providers</h2>
      </div>
      <div class="p-5">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left py-2 px-3 font-medium text-muted-foreground">Provider</th>
                <th class="text-left py-2 px-3 font-medium text-muted-foreground">Channel</th>
                <th class="text-left py-2 px-3 font-medium text-muted-foreground">Status</th>
                <th class="text-left py-2 px-3 font-medium text-muted-foreground">Health</th>
                <th class="text-left py-2 px-3 font-medium text-muted-foreground hidden md:table-cell">Success Rate</th>
                <th class="text-left py-2 px-3 font-medium text-muted-foreground hidden md:table-cell">Latency</th>
                <th class="text-left py-2 px-3 font-medium text-muted-foreground hidden lg:table-cell">Region</th>
              </tr>
            </thead>
            <tbody>
              {mockProviders.map((provider) => (
                <tr class="border-b border-border/50 last:border-0 hover:bg-muted/50 transition-colors">
                  <td class="py-3 px-3 font-medium text-foreground">{provider.name}</td>
                  <td class="py-3 px-3 capitalize text-foreground">{provider.channel}</td>
                  <td class="py-3 px-3">
                    <span class:list={[
                      "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                      provider.status === "healthy" && "bg-success/10 text-success border-success/20",
                      provider.status === "degraded" && "bg-warning/10 text-warning border-warning/20",
                      provider.status === "down" && "bg-destructive/10 text-destructive border-destructive/20",
                    ]}>
                      {provider.status}
                    </span>
                  </td>
                  <td class="py-3 px-3">
                    <div class="flex items-center gap-2">
                      <div class="h-1.5 w-16 rounded-full bg-muted overflow-hidden">
                        <div class:list={[
                          "h-full rounded-full",
                          provider.health > 99 ? "bg-success" : provider.health > 95 ? "bg-warning" : "bg-destructive",
                        ]} style={`width: ${provider.health}%`}></div>
                      </div>
                      <span class="text-xs text-muted-foreground">{provider.health}%</span>
                    </div>
                  </td>
                  <td class="py-3 px-3 text-foreground hidden md:table-cell">{provider.successRate}%</td>
                  <td class="py-3 px-3 text-foreground hidden md:table-cell">{provider.latencyMs}ms</td>
                  <td class="py-3 px-3 text-muted-foreground hidden lg:table-cell">{provider.region}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
