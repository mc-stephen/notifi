---
import AdminLayout from "../../layouts/AdminLayout.astro";
import type { AdminBroadcast } from "../../lib/types";

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";
const session = Astro.cookies.get("admin_session")?.value;
const cookieHeader = session ? { Cookie: `admin_session=${session}` } : {};

const { id } = Astro.params;

let broadcast: AdminBroadcast | null = null;
let loadError: string | null = null;
try {
  const res = await fetch(`${API_BASE}/admin/notifications/${encodeURIComponent(id ?? "")}`, {
    headers: cookieHeader,
  });
  if (res.status === 401) {
    Astro.response.status = 401;
    loadError = "Your session has expired. Please sign out and sign in again.";
  } else if (res.status === 404) {
    Astro.response.status = 404;
  } else {
    if (!res.ok) throw new Error(`Broadcast request failed (${res.status})`);
    broadcast = (await res.json()).broadcast;
  }
} catch {
  Astro.response.status = 500;
  loadError = loadError ?? "Could not load this broadcast. Check that the API is running and try again.";
}

function statusColor(status: string) {
  if (status === "sent") return "bg-success/10 text-success border-success/20";
  if (status === "scheduled") return "bg-info/10 text-info border-info/20";
  if (status === "sending") return "bg-warning/10 text-warning border-warning/20";
  return "bg-muted text-muted-foreground border-border";
}

const readRate =
  broadcast && broadcast.recipientCount > 0
    ? Math.round((broadcast.readCount / broadcast.recipientCount) * 100)
    : 0;
---

<AdminLayout title={broadcast ? `Broadcast: ${broadcast.title}` : "Broadcast not found"}>
  <div class="space-y-6">
    <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
      <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
      <span>/</span>
      <a href="/notifications" class="hover:text-foreground transition-colors">Notifications</a>
      <span>/</span>
      <span class="text-foreground font-medium">{broadcast?.title ?? id}</span>
    </nav>

    {!broadcast ? (
      <div class="rounded-xl border bg-card px-4 py-12 text-center">
        <p class="text-sm font-medium text-foreground">{loadError ? "Something went wrong" : "Broadcast not found"}</p>
        <p class="text-xs text-muted-foreground mt-1">{loadError ?? "It may have been deleted, or the link is wrong."}</p>
        <a href={loadError ? "/login" : "/notifications"} class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors mt-4">
          {loadError ? "Sign in again" : "Back to notifications"}
        </a>
      </div>
    ) : (
      <>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-foreground">{broadcast.title}</h1>
            <p class="text-sm text-muted-foreground mt-1 capitalize">
              {broadcast.notificationType.replace(/_/g, " ")} · {broadcast.channels.map((c) => c.replace("_", "-")).join(", ")} · by {broadcast.adminEmail}
            </p>
          </div>
          <span class:list={[
            "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium capitalize shrink-0",
            statusColor(broadcast.status),
          ]}>
            {broadcast.status}
          </span>
        </div>

        <div class="max-w-3xl space-y-6">
          <div class="rounded-xl border bg-card">
            <div class="p-5 border-b border-border">
              <h2 class="font-semibold text-foreground">Delivery</h2>
            </div>
            <div class="p-5 grid grid-cols-2 gap-x-4 gap-y-4">
              <div>
                <p class="text-xs text-muted-foreground">Recipients</p>
                <p class="text-sm font-medium text-foreground mt-1">{broadcast.recipientCount}</p>
              </div>
              <div>
                <p class="text-xs text-muted-foreground">Read</p>
                <p class="text-sm font-medium text-foreground mt-1">{broadcast.readCount} ({readRate}%)</p>
              </div>
              <div>
                <p class="text-xs text-muted-foreground">Created</p>
                <p class="text-sm font-medium text-foreground mt-1">{new Date(broadcast.createdAt).toLocaleString()}</p>
              </div>
              <div>
                <p class="text-xs text-muted-foreground">{broadcast.status === "scheduled" ? "Send at" : "Sent at"}</p>
                <p class="text-sm font-medium text-foreground mt-1">
                  {(broadcast.status === "scheduled" ? broadcast.scheduledFor : broadcast.sentAt)
                    ? new Date((broadcast.status === "scheduled" ? broadcast.scheduledFor : broadcast.sentAt) as string).toLocaleString()
                    : "—"}
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border bg-card">
            <div class="p-5 border-b border-border">
              <h2 class="font-semibold text-foreground">Message</h2>
            </div>
            <div class="p-5">
              <div
                class="text-sm text-foreground prose prose-sm max-w-none"
                dangerouslySetInnerHTML={{ __html: broadcast.content }}
              />
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</AdminLayout>
