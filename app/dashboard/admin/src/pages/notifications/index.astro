---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Pagination from "../../components/shared/pagination.astro";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from "../../components/ui/table";
import ComposeForm from "../../components/admin/ComposeForm.tsx";
import type { AdminBroadcast } from "../../lib/types";

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";
const session = Astro.cookies.get("admin_session")?.value;
const cookieHeader = session ? { Cookie: `admin_session=${session}` } : {};

const statusFilter = Astro.url.searchParams.get("status") ?? "";
const typeFilter = Astro.url.searchParams.get("type") ?? "";
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const LIMIT = 25;

async function fetchBroadcasts(params: URLSearchParams) {
  const res = await fetch(`${API_BASE}/admin/notifications?${params.toString()}`, {
    headers: cookieHeader,
  });
  if (!res.ok) {
    const err: Error & { status?: number } = new Error(`Request failed (${res.status})`);
    err.status = res.status;
    throw err;
  }
  return res.json();
}

let broadcasts: AdminBroadcast[] = [];
let total = 0;
let totalPages = 0;
let loadError: string | null = null;
try {
  const params = new URLSearchParams();
  if (statusFilter) params.set("status", statusFilter);
  if (typeFilter) params.set("type", typeFilter);
  params.set("limit", String(LIMIT));
  params.set("page", String(page));
  const data = await fetchBroadcasts(params);
  broadcasts = data.broadcasts ?? [];
  total = data.total ?? 0;
  totalPages = data.totalPages ?? 0;
} catch (e: any) {
  if (e?.status === 401) {
    loadError = "Your session has expired. Please sign out and sign in again.";
  } else if (e?.status === 503) {
    loadError = "Notification service is unavailable. Check that the API database is connected.";
  } else {
    loadError = "Could not load broadcasts. Check that the API is running and try again.";
  }
}

let scheduled: AdminBroadcast[] = [];
let scheduledError: string | null = null;
try {
  const params = new URLSearchParams();
  params.set("status", "scheduled");
  params.set("limit", "100");
  const data = await fetchBroadcasts(params);
  scheduled = data.broadcasts ?? [];
} catch (e: any) {
  if (e?.status !== 401 && e?.status !== 503) {
    scheduledError = "Could not load scheduled broadcasts.";
  }
}

function audienceLabel(b: AdminBroadcast) {
  if (b.audienceKind === "all") return "Everyone";
  if (b.audienceKind === "projects") return `${b.recipientCount} via projects`;
  if (b.audienceKind === "users") {
    return b.recipientCount === 1 ? "1 user" : `${b.recipientCount} users`;
  }
  return `${b.recipientCount} recipients`;
}

function statusColor(status: string) {
  if (status === "sent") return "bg-success/10 text-success border-success/20";
  if (status === "scheduled") return "bg-info/10 text-info border-info/20";
  if (status === "sending") return "bg-warning/10 text-warning border-warning/20";
  return "bg-muted text-muted-foreground border-border";
}

const pageParams: Record<string, string> = {};
if (statusFilter) pageParams.status = statusFilter;
if (typeFilter) pageParams.type = typeFilter;

const NOTIFICATION_TYPES = [
  "system", "update", "marketing", "billing", "welcome", "project_created",
  "team_add", "team_remove", "role_change", "provider_add", "provider_delete",
  "api_key_created", "api_key_revoked", "billing_change", "new_login",
];
---

<AdminLayout title="Notifications">
  <div class="space-y-6">
    <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
      <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
      <span>/</span>
      <span class="text-foreground font-medium">Notifications</span>
    </nav>

    <div class="border-b border-border">
      <div class="flex gap-0 -mb-px">
        <button class="tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-primary text-primary" data-tab="history">History</button>
        <button class="tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-muted-foreground hover:text-foreground transition-colors" data-tab="compose">Compose</button>
        <button class="tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-muted-foreground hover:text-foreground transition-colors" data-tab="scheduled">Scheduled{scheduled.length > 0 ? ` (${scheduled.length})` : ""}</button>
      </div>
    </div>

    <!-- Tab: History -->
    <div id="tab-history" class="tab-content space-y-4">
      <form method="get" class="flex flex-wrap items-center gap-3">
        <select name="status" onchange="this.form.submit()" class="flex h-9 rounded-lg border border-input bg-card px-3 py-1.5 text-sm focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
          <option value="">All Status</option>
          <option value="sent" selected={statusFilter === "sent"}>Sent</option>
          <option value="scheduled" selected={statusFilter === "scheduled"}>Scheduled</option>
          <option value="sending" selected={statusFilter === "sending"}>Sending</option>
          <option value="cancelled" selected={statusFilter === "cancelled"}>Cancelled</option>
        </select>
        <select name="type" onchange="this.form.submit()" class="flex h-9 rounded-lg border border-input bg-card px-3 py-1.5 text-sm focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
          <option value="">All Types</option>
          {NOTIFICATION_TYPES.map((t) => (
            <option value={t} selected={typeFilter === t}>{t.replace(/_/g, " ")}</option>
          ))}
        </select>
      </form>

      <div class="rounded-xl border bg-card overflow-hidden">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Title</TableHead>
              <TableHead>Audience</TableHead>
              <TableHead className="hidden md:table-cell">Recipients</TableHead>
              <TableHead className="hidden md:table-cell">Read</TableHead>
              <TableHead>Status</TableHead>
              <TableHead className="hidden lg:table-cell">Created</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {broadcasts.map((b) => (
              <TableRow data-href={`/notifications/${b.id}`} className="broadcast-row cursor-pointer">
                <TableCell>
                  <a href={`/notifications/${b.id}`} class="font-medium text-foreground hover:underline block truncate row-link">
                    {b.title}
                  </a>
                  <p class="text-xs text-muted-foreground mt-0.5 capitalize">{b.notificationType.replace(/_/g, " ")} · {b.channels.map((c) => c.replace("_", "-")).join(", ")}</p>
                </TableCell>
                <TableCell className="text-sm">{audienceLabel(b)}</TableCell>
                <TableCell className="hidden md:table-cell">{b.recipientCount}</TableCell>
                <TableCell className="hidden md:table-cell">{b.readCount}</TableCell>
                <TableCell>
                  <span class:list={[
                    "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                    statusColor(b.status),
                  ]}>
                    {b.status}
                  </span>
                </TableCell>
                <TableCell className="hidden lg:table-cell text-xs text-muted-foreground">
                  {new Date(b.createdAt).toLocaleDateString()}
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
        {loadError && (
          <div class="px-4 py-12 text-center">
            <p class="text-sm text-destructive">{loadError}</p>
            <a href="/login" class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors mt-4">
              Sign in again
            </a>
          </div>
        )}
        {!loadError && broadcasts.length === 0 && (
          <div class="px-4 py-12 text-center">
            <p class="text-sm font-medium text-foreground">No broadcasts yet</p>
            <p class="text-xs text-muted-foreground mt-1">Compose your first broadcast to reach users.</p>
          </div>
        )}
        {!loadError && (
          <Pagination page={page} totalPages={totalPages} total={total} basePath="/notifications" params={pageParams} />
        )}
      </div>
    </div>

    <!-- Tab: Compose -->
    <div id="tab-compose" class="tab-content hidden space-y-4">
      <div class="rounded-xl border bg-card">
        <div class="p-5 space-y-5">
          <ComposeForm client:load />
        </div>
      </div>
    </div>

    <!-- Tab: Scheduled -->
    <div id="tab-scheduled" class="tab-content hidden space-y-4">
      <div class="rounded-xl border bg-card overflow-hidden">
        {scheduledError ? (
          <p class="text-sm text-destructive text-center px-4 py-8">{scheduledError}</p>
        ) : scheduled.length > 0 ? (
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Title</TableHead>
                <TableHead>Audience</TableHead>
                <TableHead className="hidden md:table-cell">Send At</TableHead>
                <TableHead className="text-right">Action</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {scheduled.map((b) => (
                <TableRow>
                  <TableCell>
                    <a href={`/notifications/${b.id}`} class="font-medium text-foreground hover:underline block truncate">
                      {b.title}
                    </a>
                    <p class="text-xs text-muted-foreground mt-0.5">{b.recipientCount} recipients</p>
                  </TableCell>
                  <TableCell className="text-sm">{audienceLabel(b)}</TableCell>
                  <TableCell className="hidden md:table-cell text-xs text-muted-foreground">
                    {b.scheduledFor ? new Date(b.scheduledFor).toLocaleString() : "—"}
                  </TableCell>
                  <TableCell className="text-right">
                    <button
                      type="button"
                      data-cancel-id={b.id}
                      class="cancel-btn inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-1.5 text-xs font-medium hover:bg-muted transition-colors"
                    >
                      Cancel
                    </button>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        ) : (
          <div class="px-4 py-12 text-center">
            <p class="text-sm font-medium text-foreground">No scheduled notifications</p>
            <p class="text-xs text-muted-foreground mt-1">Scheduled notifications will appear here until they send.</p>
          </div>
        )}
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { notifications } from "../../lib/api";

  const TAB_KEY = "notifications-active-tab";
  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabContents = document.querySelectorAll<HTMLElement>(".tab-content");

  function setActiveTab(btn: HTMLButtonElement) {
    tabBtns.forEach((b) => {
      const active = b === btn;
      b.classList.toggle("border-primary", active);
      b.classList.toggle("text-primary", active);
      b.classList.toggle("border-transparent", !active);
      b.classList.toggle("text-muted-foreground", !active);
    });
  }

  function switchTab(name: string) {
    tabContents.forEach((c) => c.classList.toggle("hidden", c.id !== `tab-${name}`));
    tabBtns.forEach((b) => {
      if (b.dataset.tab === name) setActiveTab(b);
    });
    try {
      localStorage.setItem(TAB_KEY, name);
    } catch {
      // storage unavailable — tab just won't persist
    }
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => switchTab(btn.dataset.tab ?? "history"));
  });

  try {
    const saved = localStorage.getItem(TAB_KEY);
    if (saved && document.getElementById(`tab-${saved}`)) switchTab(saved);
  } catch {
    // ignore
  }

  document.querySelectorAll<HTMLTableRowElement>("tr.broadcast-row").forEach((row) => {
    row.addEventListener("click", (e) => {
      // Let the inner title link handle its own clicks (keyboard/middle-click safe).
      if ((e.target as HTMLElement).closest("a")) return;
      const href = row.dataset.href;
      if (href) window.location.href = href;
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".cancel-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.cancelId;
      if (!id || !window.confirm("Cancel this scheduled broadcast?")) return;
      btn.disabled = true;
      try {
        await notifications.cancelScheduled(id);
        window.location.reload();
      } catch (err) {
        btn.disabled = false;
        btn.textContent = err instanceof Error ? err.message : "Cancel failed";
      }
    });
  });
</script>
