---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { USER_STATUS_COLORS } from "../../lib/constants";
import type { AdminUserDetail } from "../../lib/types";

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";
const session = Astro.cookies.get("admin_session")?.value;
const cookieHeader = session ? { Cookie: `admin_session=${session}` } : {};

const { id } = Astro.params;

let user: AdminUserDetail | null = null;
let loadError: string | null = null;
try {
  const res = await fetch(`${API_BASE}/admin/users/${encodeURIComponent(id ?? "")}`, {
    headers: cookieHeader,
  });
  if (res.status === 401) {
    Astro.response.status = 401;
    loadError = "Your session has expired. Please sign out and sign in again.";
  } else if (res.status === 404) {
    Astro.response.status = 404;
  } else {
    if (!res.ok) throw new Error(`User request failed (${res.status})`);
    user = (await res.json()).user;
  }
} catch {
  Astro.response.status = 500;
  loadError = loadError ?? "Could not load this user. Check that the API is running and try again.";
}

function initials(name: string) {
  return name
    .split(" ")
    .map((n) => n[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
}
---

<AdminLayout title={user ? `User: ${user.name}` : "User not found"}>
  <div class="space-y-6">
    <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
      <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
      <span>/</span>
      <a href="/users" class="hover:text-foreground transition-colors">Users</a>
      <span>/</span>
      <span class="text-foreground font-medium">{user?.name ?? id}</span>
    </nav>

    {!user ? (
      <div class="rounded-xl border bg-card px-4 py-12 text-center">
        <p class="text-sm font-medium text-foreground">{loadError ? "Something went wrong" : "User not found"}</p>
        <p class="text-xs text-muted-foreground mt-1">{loadError ?? "This account may have been deleted, or the link is wrong."}</p>
        <a href={loadError ? "/login" : "/users"} class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors mt-4">
          {loadError ? "Sign in again" : "Back to users"}
        </a>
      </div>
    ) : (
      <>
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-base font-medium text-primary shrink-0">
              {initials(user.name)}
            </div>
            <div>
              <h1 class="text-2xl font-bold tracking-tight text-foreground">{user.name}</h1>
              <p class="text-sm text-muted-foreground mt-0.5">{user.email}</p>
            </div>
          </div>
          <span class:list={[
            "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium capitalize shrink-0",
            USER_STATUS_COLORS[user.status],
          ]}>
            {user.status}
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 space-y-6">
            <div class="rounded-xl border bg-card">
              <div class="p-5 border-b border-border">
                <h2 class="font-semibold text-foreground">Overview</h2>
              </div>
              <div class="p-5 grid grid-cols-2 gap-x-4 gap-y-4">
                <div>
                  <p class="text-xs text-muted-foreground">Email</p>
                  <p class="text-sm font-medium text-foreground mt-1 break-all">{user.email}</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Verified</p>
                  <p class="text-sm font-medium mt-1">
                    {user.emailVerified ? (
                      <span class="text-success">Verified</span>
                    ) : (
                      <span class="text-muted-foreground">Unverified</span>
                    )}
                  </p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Joined</p>
                  <p class="text-sm font-medium text-foreground mt-1">{new Date(user.createdAt).toLocaleDateString()}</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Last login</p>
                  <p class="text-sm font-medium text-foreground mt-1">{user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleString() : "—"}</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Projects</p>
                  <p class="text-sm font-medium text-foreground mt-1">{user.projectCount}</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Support tickets</p>
                  <p class="text-sm font-medium text-foreground mt-1">{user.ticketsOpen} open · {user.ticketTotal} total</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Notifications</p>
                  <p class="text-sm font-medium text-foreground mt-1">{user.notificationCount}</p>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="rounded-xl border bg-card">
              <div class="p-5 border-b border-border">
                <h2 class="font-semibold text-foreground">Actions</h2>
              </div>
              <div class="p-5 space-y-2">
                <div id="action-error" class="hidden rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive"></div>
                <div id="action-success" class="hidden rounded-lg border border-success/20 bg-success/5 p-3 text-sm text-success"></div>
                {user.status === "active" ? (
                  <button id="suspend-btn" class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-destructive/30 bg-background px-3 py-2 text-sm font-medium text-destructive hover:bg-destructive/5 transition-colors">
                    Suspend Account
                  </button>
                ) : (
                  <button id="restore-btn" class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors">
                    Restore Account
                  </button>
                )}
                <button id="revoke-btn" class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors">
                  Revoke Sessions
                </button>
                <p class="text-xs text-muted-foreground pt-1">
                  Suspending blocks sign-in immediately and revokes all sessions.
                </p>
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</AdminLayout>

<script define:vars={{ userId: user?.id }}>
  import { users, ApiError } from "../../lib/api";

  const errorDiv = document.getElementById("action-error");
  const successDiv = document.getElementById("action-success");

  function showError(message: string) {
    if (!errorDiv) return;
    errorDiv.textContent = message;
    errorDiv.classList.remove("hidden");
  }

  function showSuccess(message: string) {
    if (!successDiv) return;
    successDiv.textContent = message;
    successDiv.classList.remove("hidden");
  }

  function clearMessages() {
    errorDiv?.classList.add("hidden");
    successDiv?.classList.add("hidden");
  }

  async function setStatus(status: "active" | "suspended") {
    clearMessages();
    try {
      await users.setStatus(userId, status);
      window.location.reload();
    } catch (err) {
      showError(err instanceof ApiError ? err.message : "Action failed. Please try again.");
    }
  }

  document.getElementById("suspend-btn")?.addEventListener("click", () => {
    if (window.confirm("Suspend this account? The user will be signed out and blocked from signing in.")) {
      setStatus("suspended");
    }
  });

  document.getElementById("restore-btn")?.addEventListener("click", () => {
    setStatus("active");
  });

  document.getElementById("revoke-btn")?.addEventListener("click", async () => {
    clearMessages();
    try {
      await users.revokeSessions(userId);
      showSuccess("All sessions revoked. The user must sign in again.");
    } catch (err) {
      showError(err instanceof ApiError ? err.message : "Action failed. Please try again.");
    }
  });
</script>
