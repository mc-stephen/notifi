---
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/admin/ThemeToggle.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <div class="relative min-h-screen bg-background">
    <div class="absolute top-4 right-4 z-20">
      <ThemeToggle />
    </div>
    <div class="hidden lg:block absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,oklch(0.384_0.062_202.8/0.05),transparent_50%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_80%,oklch(0.623_0.155_250/0.03),transparent_40%)]"></div>
      <div class="absolute inset-0" style="background-image: radial-gradient(oklch(0.384 0.062 202.8 / 0.08) 1px, transparent 1px); background-size: 24px 24px;"></div>
    </div>
    <div class="relative z-10 flex min-h-screen">
      <!-- Left: Branding -->
      <div class="hidden lg:flex lg:w-1/2 flex-col items-center justify-center p-12 bg-card border-r border-border">
        <div class="max-w-md w-full space-y-6">
          <div class="flex items-center gap-3">
            <div class="size-10 rounded-lg bg-primary flex items-center justify-center shrink-0">
              <span class="text-primary-foreground font-bold text-lg">N</span>
            </div>
            <span class="text-2xl font-bold text-foreground">Notifi</span>
          </div>
          <div class="space-y-2">
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Admin Control Plane</h1>
            <p class="text-muted-foreground leading-relaxed">
              Internal administration for users, organizations, notifications, billing, and platform operations.
            </p>
          </div>
          <ul class="space-y-3 pt-2">
            <li class="flex items-center gap-3 text-sm text-foreground">
              <span class="size-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </span>
              Users & Organizations
            </li>
            <li class="flex items-center gap-3 text-sm text-foreground">
              <span class="size-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
              </span>
              Notifications & Channels
            </li>
            <li class="flex items-center gap-3 text-sm text-foreground">
              <span class="size-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
              </span>
              Billing & Audit Logs
            </li>
          </ul>
          <div class="flex items-center gap-2 pt-2 text-sm text-muted-foreground">
            <div class="size-2 rounded-full bg-success"></div>
            <span>All Systems Operational</span>
          </div>
        </div>
      </div>
      <!-- Right: Form -->
      <div class="flex-1 flex items-center justify-center p-6 lg:p-12">
        <div class="w-full max-w-sm">
          <div class="lg:hidden flex items-center justify-center gap-3 mb-8">
            <div class="size-8 rounded-lg bg-primary flex items-center justify-center">
              <span class="text-primary-foreground font-bold">N</span>
            </div>
            <span class="text-xl font-bold text-foreground">Notifi Admin</span>
          </div>
          <slot />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
