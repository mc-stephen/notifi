---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Pagination from "../../components/shared/pagination.astro";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from "../../components/ui/table";
import type { AdminAccount } from "../../lib/types";

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";
const session = Astro.cookies.get("admin_session")?.value;
const cookieHeader = session ? { Cookie: `admin_session=${session}` } : {};

const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const LIMIT = 25;

async function apiGet(path: string) {
  const res = await fetch(`${API_BASE}${path}`, { headers: cookieHeader });
  if (res.status === 401) {
    const err: Error & { status?: number } = new Error("unauthorized");
    err.status = 401;
    throw err;
  }
  if (!res.ok) throw new Error(`Request failed (${res.status})`);
  return res.json();
}

let admins: AdminAccount[] = [];
let isSuperAdmin = false;
let myId = "";
let total = 0;
let totalPages = 0;
let loadError: string | null = null;
try {
  const me = await apiGet("/admin/me");
  isSuperAdmin = me.isSuperAdmin ?? false;
  myId = me.id ?? "";
  const data = await apiGet(`/admin/admins?limit=${LIMIT}&page=${page}`);
  admins = data.admins ?? [];
  total = data.total ?? 0;
  totalPages = data.totalPages ?? 0;
} catch (e: any) {
  if (e?.status === 401) {
    loadError = "Your session has expired. Please sign out and sign in again.";
  } else {
    loadError = "Could not load admins. Check that the API is running and try again.";
  }
}

function initials(name: string) {
  return name
    .split(" ")
    .map((n) => n[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
}

function statusColor(status: string) {
  if (status === "active") return "bg-success/10 text-success border-success/20";
  if (status === "pending") return "bg-warning/10 text-warning border-warning/20";
  return "bg-muted text-muted-foreground border-border";
}
---

<AdminLayout title="Admins">
  <div class="space-y-6">
    <div class="space-y-1">
      <nav class="flex items-center gap-1 text-xs text-muted-foreground mb-2">
        <a href="/overview" class="hover:text-foreground transition-colors">Overview</a>
        <span>/</span>
        <a href="/administration" class="hover:text-foreground transition-colors">Administration</a>
        <span>/</span>
        <span class="text-foreground font-medium">Admins</span>
      </nav>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-foreground">Admin Users</h1>
          <p class="text-sm text-muted-foreground mt-1">
            {isSuperAdmin
              ? "New admins you add are active immediately."
              : "Only the super admin can add admins."}
          </p>
        </div>
        {isSuperAdmin && (
          <button
            id="add-admin-toggle"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 shrink-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Add Admin
          </button>
        )}
      </div>
    </div>

    {isSuperAdmin && (
    <div id="add-admin-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="add-admin-title">
      <div class="absolute inset-0 bg-black/50" id="add-admin-backdrop"></div>
      <div class="relative z-10 w-full max-w-md mx-4 rounded-xl border bg-card shadow-xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between p-5 border-b border-border">
          <div>
            <h2 id="add-admin-title" class="font-semibold text-foreground">Add Admin</h2>
            <p class="text-sm text-muted-foreground mt-0.5">New admins are active immediately.</p>
          </div>
          <button
            type="button"
            id="add-admin-close"
            aria-label="Close dialog"
            class="p-1.5 rounded-md hover:bg-muted text-muted-foreground hover:text-foreground transition-colors shrink-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
        <form id="add-admin-form" class="p-5 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label for="new-name" class="text-sm font-medium text-foreground">Full Name</label>
              <input
                type="text"
                id="new-name"
                required
                placeholder="Admin User"
                class="flex h-9 w-full rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
              />
            </div>
            <div class="space-y-2">
              <label for="new-email" class="text-sm font-medium text-foreground">Email</label>
              <input
                type="email"
                id="new-email"
                required
                placeholder="admin@notifi.dev"
                class="flex h-9 w-full rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
              />
            </div>
          </div>
          <div class="space-y-2">
            <label for="new-password" class="text-sm font-medium text-foreground">Temporary Password</label>
            <div class="relative">
              <input
                type="password"
                id="new-password"
                required
                autocomplete="new-password"
                placeholder="At least 8 characters"
                class="flex h-9 w-full rounded-lg border border-input bg-card pl-3 pr-10 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
              />
              <button
                type="button"
                id="toggle-new-password"
                class="absolute right-2 top-1/2 -translate-y-1/2 p-1 rounded text-muted-foreground hover:text-foreground transition-colors"
                aria-label="Toggle password visibility"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="eye-new-password"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <p class="text-xs text-muted-foreground">Minimum 8 characters. Must include uppercase, lowercase, number, and special character.</p>
          </div>
          <div id="add-error" class="hidden rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive"></div>
          <div id="add-success" class="hidden rounded-lg border border-success/20 bg-success/5 p-3 text-sm text-success"></div>
          <div class="flex justify-end gap-2 pt-1">
            <button
              type="button"
              id="add-cancel"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-muted transition-colors"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="add-btn"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 disabled:pointer-events-none disabled:opacity-50"
            >
              Create Admin
            </button>
          </div>
        </form>
      </div>
    </div>
    )}

    <div class="rounded-xl border bg-card overflow-hidden">
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>Admin</TableHead>
            <TableHead>Role</TableHead>
            <TableHead>Status</TableHead>
            <TableHead className="hidden md:table-cell">Last Login</TableHead>
            <TableHead className="text-right">Action</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {admins.map((admin) => (
            <TableRow>
              <TableCell>
                <div class="flex items-center gap-3">
                  <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-medium text-primary shrink-0">
                    {initials(admin.name)}
                  </div>
                  <div class="min-w-0">
                    <p class="font-medium text-foreground truncate">
                      {admin.name}
                      {admin.id === myId && <span class="text-xs text-muted-foreground font-normal"> (you)</span>}
                    </p>
                    <p class="text-xs text-muted-foreground truncate">{admin.email}</p>
                  </div>
                </div>
              </TableCell>
              <TableCell>
                {admin.isSuperAdmin ? (
                  <span class="inline-flex items-center rounded-md bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 text-xs font-medium">
                    Super Admin
                  </span>
                ) : (
                  <span class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">
                    Admin
                  </span>
                )}
              </TableCell>
              <TableCell>
                <span class:list={[
                  "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium capitalize",
                  statusColor(admin.status),
                ]}>
                  {admin.status}
                </span>
              </TableCell>
              <TableCell className="hidden md:table-cell text-xs text-muted-foreground">
                {admin.lastLoginAt ? new Date(admin.lastLoginAt).toLocaleString() : "—"}
              </TableCell>
              <TableCell className="text-right">
                {!admin.isSuperAdmin && admin.id !== myId && isSuperAdmin ? (
                  <button
                    type="button"
                    data-menu-btn={admin.id}
                    data-name={admin.name}
                    data-suspended={admin.status === "suspended" ? "true" : "false"}
                    aria-label={`Actions for ${admin.name}`}
                    aria-haspopup="menu"
                    class="p-1.5 rounded-md hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                  </button>
                ) : null}
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
      {loadError && (
        <div class="px-4 py-12 text-center">
          <p class="text-sm text-destructive">{loadError}</p>
          <a href="/login" class="inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-2 text-sm font-medium hover:bg-muted transition-colors mt-4">
            Sign in again
          </a>
        </div>
      )}
      {!loadError && admins.length === 0 && (
        <div class="px-4 py-12 text-center">
          <p class="text-sm font-medium text-foreground">No admins found</p>
        </div>
      )}
      {!loadError && (
        <Pagination page={page} totalPages={totalPages} total={total} basePath="/administration/admins" params={{}} />
      )}
    </div>

    <div
      id="row-menu"
      role="menu"
      class="hidden fixed z-50 w-40 rounded-lg border border-border bg-card shadow-lg py-1"
    >
      <button
        type="button"
        id="row-menu-suspend"
        role="menuitem"
        class="flex w-full items-center px-3 py-2 text-xs font-medium text-foreground hover:bg-muted transition-colors text-left"
      >
        Suspend
      </button>
      <button
        type="button"
        id="row-menu-remove"
        role="menuitem"
        class="flex w-full items-center px-3 py-2 text-xs font-medium text-destructive hover:bg-destructive/5 transition-colors text-left"
      >
        Remove
      </button>
    </div>

    <div id="confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
      <div class="absolute inset-0 bg-black/50" id="confirm-backdrop"></div>
      <div class="relative z-10 w-full max-w-sm mx-4 rounded-xl border bg-card shadow-xl">
        <div class="p-5 space-y-2">
          <h2 id="confirm-title" class="font-semibold text-foreground">Confirm</h2>
          <p id="confirm-body" class="text-sm text-muted-foreground"></p>
        </div>
        <div id="confirm-error" class="hidden mx-5 mb-4 rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive"></div>
        <div class="flex justify-end gap-2 p-5 pt-0">
          <button
            type="button"
            id="confirm-cancel"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-muted transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="confirm-go"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 disabled:pointer-events-none disabled:opacity-50"
          >
            Confirm
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { admins, ApiError } from "../../lib/api";
  import { passwordValid } from "../../lib/password";

  const toggle = document.getElementById("add-admin-toggle");
  const modal = document.getElementById("add-admin-modal");
  const form = document.getElementById("add-admin-form") as HTMLFormElement;
  const addError = document.getElementById("add-error");
  const addSuccess = document.getElementById("add-success");
  const addBtn = document.getElementById("add-btn") as HTMLButtonElement;

  const EYE_OPEN = '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
  const EYE_CLOSED = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" x2="23" y1="1" y2="23"/>';

  document.getElementById("toggle-new-password")?.addEventListener("click", () => {
    const input = document.getElementById("new-password") as HTMLInputElement;
    const icon = document.getElementById("eye-new-password");
    const shown = input.type === "password";
    input.type = shown ? "text" : "password";
    if (icon) icon.innerHTML = shown ? EYE_CLOSED : EYE_OPEN;
  });

  function openModal() {
    modal?.classList.remove("hidden");
    document.getElementById("new-name")?.focus();
  }

  function closeModal() {
    modal?.classList.add("hidden");
    form?.reset();
    addError?.classList.add("hidden");
    addSuccess?.classList.add("hidden");
  }

  toggle?.addEventListener("click", openModal);
  document.getElementById("add-admin-close")?.addEventListener("click", closeModal);
  document.getElementById("add-cancel")?.addEventListener("click", closeModal);
  document.getElementById("add-admin-backdrop")?.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });

  function showAddError(message: string) {
    if (!addError) return;
    addError.textContent = message;
    addError.classList.remove("hidden");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    addError?.classList.add("hidden");
    addSuccess?.classList.add("hidden");

    const name = (document.getElementById("new-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("new-email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("new-password") as HTMLInputElement).value;

    if (!passwordValid(password)) {
      showAddError("Password must be at least 8 characters and include an uppercase letter, a lowercase letter, a number, and a special character.");
      return;
    }

    addBtn.disabled = true;
    try {
      await admins.createAdmin({ name, email, password });
      if (addSuccess) {
        addSuccess.textContent = `Admin created and active.`;
        addSuccess.classList.remove("hidden");
      }
      form.reset();
      setTimeout(() => window.location.reload(), 1200);
    } catch (err) {
      showAddError(err instanceof ApiError ? err.message : "Could not create admin. Please try again.");
    } finally {
      addBtn.disabled = false;
    }
  });

  // Shared fixed menu: positioned next to the clicked kebab so no table
  // overflow context can clip it. One open at a time.
  const rowMenu = document.getElementById("row-menu")!;
  const menuSuspend = document.getElementById("row-menu-suspend")!;
  const menuRemove = document.getElementById("row-menu-remove")!;
  let menuTarget: { id: string; name: string; suspended: boolean } | null = null;

  function closeMenu() {
    rowMenu.classList.add("hidden");
    menuTarget = null;
  }

  function openMenu(btn: HTMLButtonElement) {
    menuTarget = {
      id: btn.dataset.menuBtn!,
      name: btn.dataset.name ?? "this admin",
      suspended: btn.dataset.suspended === "true",
    };
    menuSuspend.textContent = menuTarget.suspended ? "Unsuspend" : "Suspend";
    positionMenu(btn);
    rowMenu.classList.remove("hidden");
  }

  // Anchors the menu's top-right corner to the button's bottom-right corner
  // using the real rendered size, flipping above when space is short.
  function positionMenu(btn: HTMLButtonElement) {
    const wasHidden = rowMenu.classList.contains("hidden");
    if (wasHidden) {
      rowMenu.style.visibility = "hidden";
      rowMenu.classList.remove("hidden");
    }
    const menuWidth = rowMenu.offsetWidth;
    const menuHeight = rowMenu.offsetHeight;
    const rect = btn.getBoundingClientRect();
    let left = rect.right - menuWidth;
    let top = rect.bottom + 4;
    if (left < 8) left = 8;
    if (left + menuWidth > window.innerWidth - 8) {
      left = Math.max(8, window.innerWidth - menuWidth - 8);
    }
    if (top + menuHeight > window.innerHeight - 8) {
      top = Math.max(8, rect.top - menuHeight - 4);
    }
    rowMenu.style.left = `${left}px`;
    rowMenu.style.top = `${top}px`;
    if (wasHidden) {
      rowMenu.style.visibility = "";
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-menu-btn]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!rowMenu.classList.contains("hidden") && menuTarget?.id === btn.dataset.menuBtn) {
        closeMenu();
      } else {
        openMenu(btn);
      }
    });
  });

  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("#row-menu")) closeMenu();
  });
  // A fixed menu can't follow its anchor, so close it on any scroll/resize
  // instead of letting it float detached. Reopening re-anchors fresh.
  document.addEventListener("scroll", () => closeMenu(), true);
  window.addEventListener("resize", () => closeMenu());
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeMenu();
      closeConfirm();
    }
  });

  // Confirm dialog: shared by suspend and remove.
  const confirmModal = document.getElementById("confirm-modal");
  const confirmTitle = document.getElementById("confirm-title")!;
  const confirmBody = document.getElementById("confirm-body")!;
  const confirmError = document.getElementById("confirm-error");
  const confirmGo = document.getElementById("confirm-go") as HTMLButtonElement;
  let confirmAction: (() => Promise<void>) | null = null;

  function openConfirm(title: string, body: string, goLabel: string, action: () => Promise<void>) {
    closeMenu();
    confirmTitle.textContent = title;
    confirmBody.textContent = body;
    confirmGo.textContent = goLabel;
    confirmError?.classList.add("hidden");
    confirmAction = action;
    confirmModal?.classList.remove("hidden");
  }

  function closeConfirm() {
    confirmModal?.classList.add("hidden");
    confirmAction = null;
  }

  document.getElementById("confirm-cancel")?.addEventListener("click", closeConfirm);
  document.getElementById("confirm-backdrop")?.addEventListener("click", closeConfirm);

  confirmGo?.addEventListener("click", async () => {
    const action = confirmAction;
    if (!action) return;
    confirmGo.disabled = true;
    try {
      await action();
      window.location.reload();
    } catch (err) {
      confirmGo.disabled = false;
      if (confirmError) {
        confirmError.textContent = err instanceof ApiError ? err.message : "Action failed. Please try again.";
        confirmError.classList.remove("hidden");
      }
    }
  });

  menuRemove.addEventListener("click", () => {
    const target = menuTarget;
    if (!target) return;
    openConfirm(
      `Remove ${target.name}?`,
      "This deactivates the account immediately and signs them out everywhere. This cannot be undone from here.",
      "Remove Admin",
      () => admins.removeAdmin(target.id).then(() => {}),
    );
  });

  menuSuspend.addEventListener("click", () => {
    const target = menuTarget;
    if (!target) return;
    if (target.suspended) {
      openConfirm(
        `Restore ${target.name}?`,
        "They will be able to sign in again immediately.",
        "Restore Admin",
        () => admins.setStatus(target.id, "active").then(() => {}),
      );
    } else {
      openConfirm(
        `Suspend ${target.name}?`,
        "This blocks sign-in immediately and signs them out everywhere. You can restore them later.",
        "Suspend Admin",
        () => admins.setStatus(target.id, "suspended").then(() => {}),
      );
    }
  });
</script>
