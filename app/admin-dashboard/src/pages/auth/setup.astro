---
import AuthLayout from "../../layouts/AuthLayout.astro";
import OtpInput from "../../components/admin/OtpInput.tsx";
---

<AuthLayout title="Set Up Admin">
  <div class="space-y-6">
    <!-- Step 1: Account creation form -->
    <div id="step-form" class="space-y-6">
      <div class="space-y-2 text-center">
        <h1 class="text-2xl font-bold text-foreground">Create Admin Account</h1>
        <p class="text-sm text-muted-foreground">
          Set up the first administrator for your Notifi platform.
        </p>
      </div>

      <form id="setup-form" class="space-y-4">
        <div class="space-y-2">
          <label for="name" class="text-sm font-medium text-foreground">Full Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            placeholder="Admin User"
            class="flex h-9 w-full rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          />
        </div>

        <div class="space-y-2">
          <label for="email" class="text-sm font-medium text-foreground">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="admin@notifi.dev"
            class="flex h-9 w-full rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          />
        </div>

        <div class="space-y-2">
          <label for="password" class="text-sm font-medium text-foreground">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="new-password"
            placeholder="At least 8 characters"
            minlength="8"
            class="flex h-9 w-full rounded-lg border border-input bg-card px-3 py-1.5 text-sm transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          />
          <p class="text-xs text-muted-foreground">Minimum 8 characters. Must include uppercase, lowercase, number, and special character.</p>
        </div>

        <div id="error-message" class="hidden rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive"></div>

        <button
          type="submit"
          id="submit-btn"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 w-full"
        >
          <span id="btn-text">Create Admin</span>
          <svg id="btn-spinner" class="hidden size-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </button>
      </form>
    </div>

    <!-- Step 2: TOTP setup (hidden initially) -->
    <div id="step-totp" class="hidden space-y-6">
      <div class="space-y-2 text-center">
        <h1 class="text-2xl font-bold text-foreground">Set Up 2FA</h1>
        <p class="text-sm text-muted-foreground">
          Scan this QR code with your authenticator app, then enter the 6-digit code.
        </p>
      </div>

      <div class="flex justify-center">
        <div id="qr-container" class="rounded-lg border border-border bg-white p-4">
          <div class="text-sm text-muted-foreground text-center">Loading QR code...</div>
        </div>
      </div>

      <div id="secret-display" class="hidden space-y-1">
        <p class="text-xs text-muted-foreground text-center">Manual entry key:</p>
        <code id="secret-value" class="block text-center text-xs font-mono bg-muted rounded-md px-3 py-2 break-all"></code>
      </div>

      <form id="totp-form" class="space-y-6">
        <div class="space-y-2">
          <label class="text-sm font-medium text-foreground">Verification Code</label>
          <OtpInput client:load />
          <input type="hidden" id="totp-code" />
        </div>

        <div id="totp-error" class="hidden rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive"></div>

        <button
          type="submit"
          id="totp-btn"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/80 focus-visible:border-ring focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 w-full"
        >
          <span id="totp-btn-text">Verify & Complete Setup</span>
          <svg id="totp-btn-spinner" class="hidden size-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</AuthLayout>

<script>
  import { auth, ApiError } from "../../lib/api";
  import { passwordValid } from "../../lib/password";
  import { renderQrCode } from "../../lib/qrcode";

  // Step 1: Account creation
  const setupForm = document.getElementById("setup-form") as HTMLFormElement;
  const stepForm = document.getElementById("step-form")!;
  const stepTotp = document.getElementById("step-totp")!;
  const errorDiv = document.getElementById("error-message")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text")!;
  const btnSpinner = document.getElementById("btn-spinner")!;

  setupForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorDiv.classList.add("hidden");

    const password = (document.getElementById("password") as HTMLInputElement).value;
    if (!passwordValid(password)) {
      errorDiv.textContent =
        "Password must be at least 8 characters and include an uppercase letter, a lowercase letter, a number, and a special character.";
      errorDiv.classList.remove("hidden");
      return;
    }

    btnText.textContent = "";
    btnSpinner.classList.remove("hidden");
    submitBtn.disabled = true;

    const name = (document.getElementById("name") as HTMLInputElement).value;
    const email = (document.getElementById("email") as HTMLInputElement).value;

    try {
      const data = await auth.bootstrap({ name, email, password });

      await renderQrCode(document.getElementById("qr-container")!, data.totpUri);
      document.getElementById("secret-value")!.textContent = data.totpSecret;
      document.getElementById("secret-display")!.classList.remove("hidden");
      stepForm.classList.add("hidden");
      stepTotp.classList.remove("hidden");
    } catch (err) {
      errorDiv.textContent = err instanceof ApiError ? err.message : "Setup failed. Please try again.";
      errorDiv.classList.remove("hidden");
    } finally {
      btnText.textContent = "Create Admin";
      btnSpinner.classList.add("hidden");
      submitBtn.disabled = false;
    }
  });

  // Step 2: TOTP verification
  const totpForm = document.getElementById("totp-form") as HTMLFormElement;
  const totpError = document.getElementById("totp-error")!;
  const totpBtn = document.getElementById("totp-btn") as HTMLButtonElement;
  const totpBtnText = document.getElementById("totp-btn-text")!;
  const totpBtnSpinner = document.getElementById("totp-btn-spinner")!;
  const hiddenCode = document.getElementById("totp-code") as HTMLInputElement;

  let verifying = false;

  async function verifySetup(code: string) {
    if (verifying) return;
    verifying = true;
    totpError.classList.add("hidden");
    totpBtnText.textContent = "";
    totpBtnSpinner.classList.remove("hidden");
    totpBtn.disabled = true;

    try {
      await auth.totpVerify(code);
      window.location.href = "/overview";
    } catch (err) {
      totpError.textContent = err instanceof ApiError ? err.message : "Verification failed. Please try again.";
      totpError.classList.remove("hidden");
    } finally {
      verifying = false;
      totpBtnText.textContent = "Verify & Complete Setup";
      totpBtnSpinner.classList.add("hidden");
      totpBtn.disabled = false;
    }
  }

  totpForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (hiddenCode.value.length === 6) {
      verifySetup(hiddenCode.value);
    } else {
      totpError.textContent = "Enter all 6 digits.";
      totpError.classList.remove("hidden");
    }
  });

  window.addEventListener("otp:complete", (e) => {
    hiddenCode.value = (e as CustomEvent<string>).detail;
    verifySetup(hiddenCode.value);
  });
</script>
