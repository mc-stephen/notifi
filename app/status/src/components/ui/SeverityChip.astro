---
import type { IncidentSeverity, IncidentPhase } from "../../lib/types";

interface Props {
  severity: IncidentSeverity;
}

const labels: Record<IncidentSeverity, string> = {
  minor: "Minor",
  major: "Major",
  critical: "Critical",
};

const { severity } = Astro.props;
---

<span class:list={["chip", `chip-${severity}`]}>{labels[severity]}</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--fg-muted);
  }

  .chip-minor {
    border-color: transparent;
    background: var(--maintenance-bg);
    color: var(--maintenance);
  }

  .chip-major {
    border-color: transparent;
    background: var(--degraded-bg);
    color: var(--degraded);
  }

  .chip-critical {
    border-color: transparent;
    background: var(--major-bg);
    color: var(--major);
  }
</style>
