---
interface Props {
  items: { href: string; label: string }[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i === items.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : (
          <a href={item.href}>{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--fg-faint);
  }

  .breadcrumbs li:not(:first-child)::before {
    content: "/";
    margin-right: 0.375rem;
    color: var(--fg-faint);
    opacity: 0.6;
  }

  .breadcrumbs a {
    color: var(--fg-muted);
  }
</style>
