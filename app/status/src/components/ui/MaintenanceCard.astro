---
import StatusDot from "./StatusDot.astro";
import { MAINTENANCE_LABELS, type Maintenance, type MaintenanceState } from "../../lib/types";
import { formatDateTime, timeUntil } from "../../lib/format";

interface Props {
  maintenance: Maintenance;
  now?: Date;
}

const { maintenance, now = new Date() } = Astro.props;

const stateToDot: Record<MaintenanceState, ComponentStateLike> = {
  scheduled: "maintenance",
  in_progress: "maintenance",
  completed: "operational",
};

type ComponentStateLike = "maintenance" | "operational";
---

<article class="maintenance-card card">
  <a href={`/maintenance/${maintenance.slug}`} class="maintenance-title">
    <h3>{maintenance.title}</h3>
  </a>
  <div class="maintenance-meta">
    <span class:list={["mstate", `mstate-${maintenance.status}`]}>
      <StatusDot state={stateToDot[maintenance.status]} size="sm" />
      {MAINTENANCE_LABELS[maintenance.status]}
    </span>
    <span class="meta-item">
      {formatDateTime(maintenance.startTime)} → {formatDateTime(maintenance.endTime)}
    </span>
    {maintenance.status !== "completed" && (
      <span class="meta-item">{timeUntil(maintenance.startTime, now)}</span>
    )}
  </div>
  {maintenance.affectedComponents.length > 0 && (
    <p class="affected">Affects: {maintenance.affectedComponents.join(", ")}</p>
  )}
</article>

<style>
  .maintenance-card {
    padding: 1rem 1.125rem;
  }

  .maintenance-title {
    display: block;
    margin-bottom: 0.5rem;
  }

  .maintenance-title h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--fg);
  }

  .maintenance-title:hover h3 {
    color: var(--accent);
  }

  .maintenance-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .mstate {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .mstate-scheduled,
  .mstate-in_progress {
    color: var(--maintenance);
  }

  .mstate-completed {
    color: var(--operational);
  }

  .meta-item {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .affected {
    margin: 0.625rem 0 0;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
</style>
