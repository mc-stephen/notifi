---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Nothing here right now", description = "This section is empty — which is the best kind of empty for a status page." } = Astro.props;
---

<div class="empty-state">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
    <circle cx="12" cy="12" r="9" fill="var(--operational)" fill-opacity="0.9" />
    <circle cx="12" cy="12" r="13" fill="none" stroke="var(--operational)" stroke-opacity="0.3" stroke-width="1.5" />
  </svg>
  <h2>{title}</h2>
  <p>{description}</p>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 3rem 1.5rem;
  }

  .empty-state h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .empty-state p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
</style>
