---
import StatusDot from "./StatusDot.astro";
import { STATE_LABELS, type ComponentState } from "../../lib/types";

interface Props {
  state: ComponentState;
  size?: "sm" | "md" | "lg";
  label?: string;
}

const { state, size = "sm", label } = Astro.props;
const text = label ?? STATE_LABELS[state];
---

<span class:list={["status-badge", `badge-${state}`, `badge-${size}`]}>
  <StatusDot state={state} size={size} />
  <span>{text}</span>
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.5625rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .badge-operational {
    background: var(--operational-bg);
    border-color: transparent;
    color: var(--operational);
  }
  .badge-degraded {
    background: var(--degraded-bg);
    border-color: transparent;
    color: var(--degraded);
  }
  .badge-partial_outage {
    background: var(--partial-bg);
    border-color: transparent;
    color: var(--partial);
  }
  .badge-major_outage {
    background: var(--major-bg);
    border-color: transparent;
    color: var(--major);
  }
  .badge-maintenance {
    background: var(--maintenance-bg);
    border-color: transparent;
    color: var(--maintenance);
  }

  .badge-md {
    padding: 0.3125rem 0.75rem;
    font-size: var(--text-sm);
  }
  .badge-lg {
    padding: 0.5rem 1rem;
    font-size: var(--text-base);
  }
</style>
