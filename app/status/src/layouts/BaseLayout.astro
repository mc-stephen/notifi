---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Route path used for canonical URL + OG. e.g. "/incidents/foo" */
  path?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  image = "/og/status-default.svg",
  path = "/",
  jsonLd,
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Notifi Status — RSS" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="Notifi Status — Atom" href="/atom.xml" />
    <meta name="theme-color" content="#09090b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Notifi Status" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      {
        /* Apply theme before first paint. No flash of wrong theme, no hydration cost. */
      }
      (() => {
        try {
          const stored = localStorage.getItem("notifi-theme");
          const theme =
            stored === "dark" || stored === "light"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {
          /* SSR/privacy-mode safe */
        }
      })();
    </script>

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
