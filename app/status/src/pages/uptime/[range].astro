---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import UptimeView from "../../components/uptime/UptimeView.astro";
import { getIncidents, getMaintenance } from "../../lib/data";
import { UPTIME_RANGES, type UptimeRange } from "../../lib/uptime";

export async function getStaticPaths() {
  return UPTIME_RANGES.filter((r) => r !== "30d").map((range) => ({
    params: { range },
  }));
}

const range = Astro.params.range as UptimeRange | undefined;

if (!range || !(UPTIME_RANGES as readonly string[]).includes(range)) {
  return new Response(null, { status: 404 });
}

const [incidents, maintenance] = await Promise.all([getIncidents(), getMaintenance()]);
const now = new Date();

const title = `Uptime (${range}) — Notifi Status`;
const description = `Notifi platform availability over ${range}.`;
---

<BaseLayout title={title} description={description} path={`/uptime/${range}`}>
  <PageLayout currentPath="/uptime">
    <section class="container page-head">
      <h1>Uptime history</h1>
      <p>Availability is computed from incident timelines. Scheduled maintenance windows are excluded. All times UTC.</p>
    </section>
    <section class="container">
      <UptimeView range={range} incidents={incidents} maintenance={maintenance} now={now} />
    </section>
  </PageLayout>
</BaseLayout>

<style>
  .page-head {
    padding-block: 2.5rem 1.5rem;
  }

  .page-head h1 {
    margin: 0 0 0.5rem;
  }

  .page-head p {
    margin: 0 0 2rem;
    color: var(--fg-muted);
    max-width: 60ch;
  }
</style>
