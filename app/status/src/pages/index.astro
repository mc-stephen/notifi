---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";
import StatusDot from "../components/ui/StatusDot.astro";
import ComponentGrid from "../components/ui/ComponentGrid.astro";
import IncidentCard from "../components/ui/IncidentCard.astro";
import MaintenanceCard from "../components/ui/MaintenanceCard.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Sparkline from "../components/charts/Sparkline.astro";
import { getComponents, getIncidents, getMaintenance } from "../lib/data";
import { openIncidents, resolvedIncidents, resolveGlobalHealth } from "../lib/status";
import { uptimeSeries, rangeAvailability } from "../lib/uptime";
import { formatPercent } from "../lib/format";

const [components, incidents, maintenance] = await Promise.all([
  getComponents(),
  getIncidents(),
  getMaintenance(),
]);

const now = new Date();
const global = resolveGlobalHealth(components, incidents, maintenance, now);
const open = openIncidents(incidents, now);
const recent = resolvedIncidents(incidents, now).slice(0, 5);
const upcoming = maintenance
  .filter((m) => m.status !== "completed")
  .sort((a, b) => a.startTime.localeCompare(b.startTime));
const completed = maintenance.filter((m) => m.status === "completed").slice(-3);

const uptime90d = uptimeSeries("90d", incidents, now);
const uptime90dValue = rangeAvailability("90d", incidents, now);

const api = components.find((c) => c.slug === "public-api");
const notify = components.find((c) => c.slug === "notification-api");
const providers = components.filter((c) => c.subsystem === "providers");
const deliverySuccess = providers.length
  ? Math.round((providers.reduce((a, c) => a + c.probe.availability["30d"], 0) / providers.length) * 100) / 100
  : 100;

const title = "Notifi Status — Platform Health";
const description = `All systems ${global.state === "operational" ? "operational" : "experiencing issues"}. Notifi notification platform uptime, incidents, and maintenance.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Notifi Status",
    url: "https://status.notifi.dev/",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Notifi",
    url: "https://notifi.dev/",
    sameAs: ["https://status.notifi.dev/"],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Notifi Notification Platform",
    serviceType: "Notification Platform as a Service",
    provider: { "@type": "Organization", name: "Notifi" },
    url: "https://notifi.dev/",
    audience: { "@type": "BusinessAudience" },
    termsOfService: "https://notifi.dev/terms",
  },
];
const ogByState: Record<typeof global.state, string> = {
  operational: "/og/status-default.svg",
  degraded: "/og/status-degraded.svg",
  partial_outage: "/og/status-partial.svg",
  major_outage: "/og/status-major.svg",
  maintenance: "/og/status-maintenance.svg",
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} image={ogByState[global.state]}>
  <PageLayout currentPath="/">
    <section class="container hero fade-in" aria-live="polite">
      <div class="hero-left">
        <p class="eyebrow">Platform Status</p>
        <h1>
          <StatusDot state={global.state} size="lg" />
          <span>
            {global.state === "operational"
              ? "All Systems Operational"
              : global.state === "maintenance"
                ? "Under Maintenance"
                : "Systems Experiencing Issues"}
          </span>
        </h1>
        <p class="hero-summary">
          {formatPercent(uptime90dValue)} uptime over the last 90 days.
          {global.state === "operational"
            ? " All components are receiving and processing traffic normally."
            : ` ${open.length} open incident${open.length === 1 ? "" : "s"} — see below for details.`}
        </p>
      </div>
      <figure class="hero-chart">
        <Sparkline values={uptime90d.map((p) => p.availability)} width={220} height={56} label={`90 day uptime: ${formatPercent(uptime90dValue)}`} />
        <figcaption>Uptime · last 90 days · <a href="/uptime">history →</a></figcaption>
      </figure>
    </section>

    {(open.length > 0 || upcoming.length > 0) && (
      <section class="container alerts">
        {open.length > 0 && (
          <div class="alert alert-active">
            <h2>
              <StatusDot state="major_outage" size="sm" />
              Active incidents ({open.length})
            </h2>
            <ul>
              {open.map((inc) => (
                <li>
                  <a href={`/incidents/${inc.slug}`}>{inc.title}</a>
                  <span class="alert-meta">{inc.status} · {inc.severity}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {upcoming.length > 0 && (
          <div class="alert alert-maintenance">
            <h2>
              <StatusDot state="maintenance" size="sm" />
              Upcoming maintenance
            </h2>
            <ul>
              {upcoming.map((m) => (
                <li>
                  <a href={`/maintenance/${m.slug}`}>{m.title}</a>
                  <span class="alert-meta">{m.status} · {m.startTime.slice(0, 10)} UTC</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <section class="container section">
      <h2>Component health</h2>
      <ComponentGrid components={global.components} />
      <p class="section-link"><a href="/components">Full component dashboard →</a></p>
    </section>

    <section class="container section">
      <h2>Performance</h2>
      <div class="metric-grid">
        <div class="metric card">
          <span class="metric-label">API p95 latency</span>
          <span class="metric-value mono">{api?.probe.latency.p95 ?? "—"}ms</span>
        </div>
        <div class="metric card">
          <span class="metric-label">Notification p95 latency</span>
          <span class="metric-value mono">{notify?.probe.latency.p95 ?? "—"}ms</span>
        </div>
        <div class="metric card">
          <span class="metric-label">Delivery success (30d)</span>
          <span class="metric-value mono">{formatPercent(deliverySuccess)}</span>
        </div>
        <div class="metric card">
          <span class="metric-label">Uptime (90d)</span>
          <span class="metric-value mono">{formatPercent(uptime90dValue)}</span>
        </div>
      </div>
      <p class="section-link"><a href="/performance">Performance dashboards →</a></p>
    </section>

    <section class="container section">
      <div class="two-col">
        <div>
          <h2>Recent incidents</h2>
          {recent.length > 0 ? (
            <div class="card-list">
              {recent.map((inc) => <IncidentCard incident={inc} now={now} />)}
            </div>
          ) : (
            <EmptyState title="No incidents in the last 14 days" description="This page shows incidents that affected components in the last 14 days." />
          )}
          <p class="section-link"><a href="/incidents">All incidents →</a></p>
        </div>
        <div>
          <h2>Maintenance</h2>
          {upcoming.length > 0 || completed.length > 0 ? (
            <div class="card-list">
              {upcoming.map((m) => <MaintenanceCard maintenance={m} now={now} />)}
              {completed.map((m) => <MaintenanceCard maintenance={m} now={now} />)}
            </div>
          ) : (
            <EmptyState title="No scheduled maintenance" />
          )}
          <p class="section-link"><a href="/maintenance">All maintenance →</a></p>
        </div>
      </div>
    </section>

    <section class="container section quick-links">
      <h2>Quick links</h2>
      <ul>
        <li><a href="/uptime">Uptime history</a></li>
        <li><a href="/performance">Performance</a></li>
        <li><a href="/reports">Historical reports</a></li>
        <li><a href="/subscribe">Subscribe</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/atom.xml">Atom</a></li>
        <li><a href="/api/status.json">Status API</a></li>
      </ul>
    </section>
  </PageLayout>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }

  .hero h1 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
  }

  .hero-summary {
    margin: 0;
    color: var(--fg-muted);
  }

  .hero-chart {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.375rem;
  }

  .hero-chart figcaption {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .alerts {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 48rem) {
    .alerts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .alert {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 1rem 1.125rem;
  }

  .alert-active {
    border-color: color-mix(in srgb, var(--major) 45%, var(--border));
    background: var(--major-bg);
  }

  .alert-maintenance {
    border-color: color-mix(in srgb, var(--maintenance) 45%, var(--border));
    background: var(--maintenance-bg);
  }

  .alert h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: var(--text-base);
  }

  .alert ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }

  .alert a {
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: 550;
  }

  .alert-meta {
    margin-left: 0.5rem;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .section {
    padding-block: 1rem 2.5rem;
  }

  .section h2 {
    margin: 0 0 1rem;
    font-size: var(--text-xl);
  }

  .section-link {
    margin: 0.875rem 0 0;
    font-size: var(--text-sm);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 48rem) {
    .metric-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
  }

  .metric-label {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .metric-value {
    font-size: var(--text-xl);
    font-weight: 650;
  }

  .two-col {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 64rem) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card-list {
    display: grid;
    gap: 0.75rem;
  }

  .quick-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--text-sm);
  }
</style>
