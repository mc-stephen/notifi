---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";
import LatencyChart from "../components/charts/LatencyChart.astro";
import FrequencyChart from "../components/charts/FrequencyChart.astro";
import { getComponents, getIncidents, getMetrics } from "../lib/data";
import { formatDateTime, formatNumber, formatPercent } from "../lib/format";
import { incidentFrequency } from "../lib/uptime";

const [components, incidents, metrics] = await Promise.all([getComponents(), getIncidents(), getMetrics()]);
const now = new Date();

const latencySorted = [...components].sort((a, b) => b.probe.latency.p95 - a.probe.latency.p95);
const frequency = incidentFrequency(incidents, 12, now);
const providerSuccess = components
  .filter((c) => c.subsystem === "providers")
  .map((c) => c.probe.availability["30d"]);

const title = "Performance — Notifi Status";
const description = "Live operational metrics for the Notifi platform: latency, throughput, delivery success, and more.";
---

<BaseLayout title={title} description={description} path="/performance">
  <PageLayout currentPath="/performance">
    <section class="container page-head">
      <h1>Performance</h1>
      <p>Operational metrics from synthetic probes and platform instrumentation. Snapshot at <time datetime={metrics.generatedAt}>{formatDateTime(metrics.generatedAt)}</time>.</p>
    </section>

    <section class="container metric-grid">
      <div class="metric card">
        <span class="metric-label">API response time (p95)</span>
        <span class="metric-value mono">{formatNumber(metrics.apiResponseTimeP95Ms)}ms</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Webhook latency (p95)</span>
        <span class="metric-value mono">{formatNumber(metrics.webhookLatencyP95Ms)}ms</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Notification processing (p95)</span>
        <span class="metric-value mono">{formatNumber(metrics.notificationProcessingP95Ms)}ms</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Queue depth</span>
        <span class="metric-value mono">{formatNumber(metrics.queueDepth)}</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Worker throughput</span>
        <span class="metric-value mono">{metrics.workerThroughputPerSec}/s</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Database health</span>
        <span class="metric-value mono">{metrics.databaseHealth}</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Cache hit rate</span>
        <span class="metric-value mono">{formatPercent(metrics.cacheHitRatePct)}</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Delivery success (30d)</span>
        <span class="metric-value mono">{formatPercent(metrics.deliverySuccessRate30d)}</span>
      </div>
      <div class="metric card">
        <span class="metric-label">Regional availability</span>
        <span class="metric-value mono">{formatPercent(metrics.regionalAvailabilityPct)}</span>
      </div>
    </section>

    <section class="container grid-2">
      <div class="card chart-card">
        <h2>p95 latency by component</h2>
        <LatencyChart components={latencySorted} />
      </div>
      <div class="card chart-card">
        <h2>Provider delivery success (30d)</h2>
        <ul class="provider-list">
          {components
            .filter((c) => c.subsystem === "providers")
            .map((c) => (
              <li>
                <span>{c.name}</span>
                <span class="mono">{formatPercent(c.probe.availability["30d"])}</span>
              </li>
            ))}
        </ul>
        {providerSuccess.length > 0 && (
          <p class="chart-note">
            Aggregate: {formatPercent(providerSuccess.reduce((a, b) => a + b, 0) / providerSuccess.length)}
          </p>
        )}
      </div>
    </section>

    <section class="container card chart-card">
      <h2>Incident frequency</h2>
      <FrequencyChart series={frequency} />
      <p class="chart-note">Incidents per month, last 12 months.</p>
    </section>
  </PageLayout>
</BaseLayout>

<style>
  .page-head {
    padding-block: 2.5rem 1.5rem;
  }

  .page-head h1 {
    margin: 0 0 0.5rem;
  }

  .page-head p {
    margin: 0 0 2rem;
    color: var(--fg-muted);
    max-width: 60ch;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 48rem) {
    .metric-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .metric-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
  }

  .metric-label {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .metric-value {
    font-size: var(--text-lg);
    font-weight: 650;
  }

  .grid-2 {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 64rem) {
    .grid-2 {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .chart-card {
    padding: 1.25rem;
  }

  .chart-card h2 {
    margin: 0 0 0.875rem;
    font-size: var(--text-base);
  }

  .provider-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .provider-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .provider-list li:last-child {
    border-bottom: none;
  }

  .chart-note {
    margin: 0.75rem 0 0;
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }
</style>
