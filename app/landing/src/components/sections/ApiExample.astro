---
import { highlight } from "../../lib/highlight";

const rawExamples = [
  {
    id: "js",
    label: "JavaScript",
    lang: "javascript",
    filename: "send.js",
    code: `import { Notifi } from "@notifi/sdk";

const notifi = new Notifi({ apiKey: process.env.NOTIFI_KEY });

await notifi.send({
  channels: ["email", "sms", "apns"],
  to: { email: "user@company.com", phone: "+15551234567" },
  template: "order-updated",
  variables: { orderId: "ord_8fkN2" },
});`,
  },
  {
    id: "python",
    label: "Python",
    lang: "python",
    filename: "send.py",
    code: `from notifi import Notifi

notifi = Notifi(api_key=os.environ["NOTIFI_KEY"])

notifi.send(
    channels=["email", "sms", "apns"],
    to={"email": "user@company.com", "phone": "+15551234567"},
    template="order-updated",
    variables={"order_id": "ord_8fkN2"},
)`,
  },
  {
    id: "go",
    label: "Go",
    lang: "go",
    filename: "send.go",
    code: `client := notifi.New(notifi.WithKey(os.Getenv("NOTIFI_KEY")))

_, err := client.Send(ctx, notifi.SendRequest{
    Channels: []string{"email", "sms", "apns"},
    To: notifi.Recipient{
        Email: "user@company.com",
        Phone: "+15551234567",
    },
    Template: "order-updated",
    Variables: map[string]string{"orderId": "ord_8fkN2"},
})`,
  },
  {
    id: "curl",
    label: "cURL",
    lang: "shell",
    filename: "curl",
    code: `curl -X POST https://api.notifi.dev/v1/notifications \\
  -H "Authorization: Bearer $NOTIFI_KEY" \\
  -H "Idempotency-Key: ord_8fkN2-1" \\
  -d '{
    "channels": ["email", "sms", "apns"],
    "to": { "email": "user@company.com", "phone": "+15551234567" },
    "template": "order-updated",
    "variables": { "orderId": "ord_8fkN2" }
  }'`,
  },
];

const examples = await Promise.all(
  rawExamples.map(async (example) => ({
    ...example,
    highlighted: await highlight(example.code, example.lang),
  })),
);

const response = `{
  "notification_id": "ntf_01J2X",
  "status": "delivered",
  "channels": {
    "email": { "status": "delivered", "at": "412ms" },
    "sms":   { "status": "delivered", "at": "388ms" },
    "apns":  { "status": "delivered", "at": "401ms" }
  },
  "events": "https://api.notifi.dev/v1/notifications/ntf_01J2X/events"
}`;

const highlightedResponse = await highlight(response, "json");
---

<section class="section apiex" id="api">
  <div class="container" data-reveal>
    <header class="section-head">
      <p class="eyebrow">The API</p>
      <h2 class="section-title">Sending is one request.</h2>
      <p class="section-sub">
        Idempotency keys, typed SDKs, and a response you can trust. Pick a language —
        the shape is the same everywhere.
      </p>
    </header>

    <div class="api-card card" data-tabs>
      <div class="api-tabs" role="tablist" aria-label="Code example language">
        {examples.map((example, i) => (
          <button
            id={`tab-${example.id}`}
            class="api-tab"
            type="button"
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${example.id}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {example.label}
          </button>
        ))}
      </div>

      <div class="api-body">
        {examples.map((example, i) => (
          <div
            id={`panel-${example.id}`}
            class="api-code"
            role="tabpanel"
            aria-labelledby={`tab-${example.id}`}
            hidden={i !== 0 ? true : undefined}
          >
            <div class="api-code-head">
              <span class="mono">{example.filename}</span>
              <button class="api-run" type="button" data-run={example.id}>Run</button>
            </div>
            <pre><code class="mono" set:html={example.highlighted} /></pre>
          </div>
        ))}

        <div class="api-response">
          <div class="api-response-head">
            <span class="mono">response</span>
            <span class="api-status mono" id="api-status">
              delivered in 412ms across 3 channels
            </span>
          </div>
          <pre><code class="mono" set:html={highlightedResponse} /></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-20);
    background: var(--color-surface-muted);
    border-block: 1px solid var(--color-border-subtle);
  }

  .section-head {
    max-width: 40rem;
    margin: 0 auto var(--space-12);
    text-align: center;
  }

  .section-title {
    margin: var(--space-3) 0 0;
  }

  .section-sub {
    margin: var(--space-4) auto 0;
    color: var(--color-foreground-muted);
  }

  .api-card {
    max-width: 72rem;
    margin-inline: auto;
    overflow: hidden;
    background: var(--color-code-surface);
    border-color: var(--color-code-border-subtle);
    box-shadow: var(--shadow-md);
  }

  .api-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) 0;
    background: var(--color-code-bar);
    border-bottom: 1px solid var(--color-code-border-subtle);
  }

  .api-tab {
    padding: 0.5rem 0.875rem;
    border: none;
    background: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-code-foreground-muted);
    cursor: pointer;
  }

  .api-tab:hover {
    color: var(--color-code-foreground);
  }

  .api-tab[aria-selected="true"] {
    color: var(--color-primary-400);
    background: var(--color-code-surface);
    border: 1px solid var(--color-code-border-subtle);
    border-bottom-color: var(--color-code-surface);
    margin-bottom: -1px;
  }

  .api-body {
    display: grid;
  }

  .api-code,
  .api-response {
    background: var(--color-code-bg);
  }

  .api-code-head,
  .api-response-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.625rem var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-code-foreground-muted);
    border-bottom: 1px solid var(--color-code-border-subtle);
  }

  .api-run {
    padding: 0.3125rem 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-primary-400);
    background: transparent;
    color: var(--color-primary-400);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .api-run:hover {
    background: oklch(0.65 0.22 280 / 0.12);
  }

  pre {
    margin: 0;
    padding: var(--space-5);
    overflow-x: auto;
  }

  pre code {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: 1.6;
    color: var(--notifi-foreground);
    font-variant-numeric: tabular-nums;
    white-space: pre;
  }

  .api-response {
    background: var(--color-code-bg);
    border-top: 1px solid var(--color-code-border);
  }

  .api-status {
    color: var(--color-success);
  }

  .api-status.is-ok {
    color: var(--color-success);
  }

  @media (min-width: 64rem) {
    .api-body {
      grid-template-columns: 3fr 2fr;
    }

    .api-code,
    .api-response {
      min-width: 0;
    }

    .api-response {
      border-top: none;
      border-left: 1px solid var(--color-code-border);
    }
  }
</style>

<script>
  import "../../islands/tabs";
</script>