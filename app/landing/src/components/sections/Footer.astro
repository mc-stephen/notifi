---
import Logo from "../ui/Logo.astro";
import LiveStatusPill from "../ui/LiveStatusPill.astro";

const groups = [
  {
    heading: "Product",
    links: [
      { href: "/#channels", label: "Channels" },
      { href: "/#architecture", label: "Architecture" },
      { href: "/#analytics", label: "Analytics" },
      { href: "/pricing", label: "Pricing" },
      { href: "/changelog", label: "Changelog" },
      { href: "/security", label: "Security" },
      { href: "/sdk", label: "SDKs" },
    ],
  },
  {
    heading: "Developers",
    links: [
      { href: "https://docs.notifi.dev", label: "Docs" },
      { href: "https://docs.notifi.dev/api-reference", label: "API Reference" },
      { href: "https://status.notifi.dev", label: "Status" },
      { href: "https://docs.notifi.dev/quickstart", label: "Guides" },
      { href: "/blog", label: "Blog" },
    ],
  },
  {
    heading: "Company",
    links: [
      { href: "/enterprise", label: "Enterprise" },
      { href: "/security", label: "Security" },
      { href: "/contact-sales", label: "Contact Sales" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/legal/privacy", label: "Privacy" },
      { href: "/legal/terms", label: "Terms" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Notifi — home">
          <Logo />
        </a>
        <p class="footer-tagline">One API. Every notification. Every platform.</p>
        <LiveStatusPill />
      </div>

      {groups.map((group) => (
        <nav class="footer-group" aria-label={group.heading}>
          <h2>{group.heading}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      <p>© 2026 Notifi · <a href="https://docs.notifi.dev">docs</a> · <a href="https://status.notifi.dev">status</a> · <a href="https://dashboard.notifi.dev">dashboard</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-surface-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-8);
  }

  .footer-brand {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .footer-tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
    max-width: 24ch;
  }

  .footer-group h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-faint);
  }

  .footer-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .footer-group a {
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }

  .footer-group a:hover {
    color: var(--color-foreground);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border-subtle);
    padding-block: var(--space-5);
  }

  .footer-bottom p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-foreground-faint);
  }

  .footer-bottom a {
    color: var(--color-foreground-muted);
  }

  @media (min-width: 40rem) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .footer-grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
    }
  }
</style>