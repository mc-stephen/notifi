---
interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, title, sub, primaryCta, secondaryCta } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {sub && <p class="page-hero-sub">{sub}</p>}
    {(primaryCta || secondaryCta) && (
      <div class="page-hero-ctas">
        {primaryCta && (
          <a class="btn btn-primary" href={primaryCta.href}>
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a class="btn btn-secondary" href={secondaryCta.href}>
            {secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding: var(--space-20) 0 var(--space-16);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .page-hero h1 {
    margin: var(--space-4) 0 0;
    max-width: 16ch;
    letter-spacing: -0.03em;
  }

  .page-hero-sub {
    margin: var(--space-4) 0 0;
    max-width: 38rem;
    color: var(--color-foreground-muted);
    line-height: 1.65;
  }

  .page-hero-ctas {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }
</style>