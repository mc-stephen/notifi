---
/** Trust strip — capability ticker until real customer logos exist. */
const capabilities = ["Email", "SMS", "Push", "Webhooks", "Desktop", "RCS"];
---

<section class="trustbar" aria-label="Coverage">
  <div class="container">
    <p class="trustbar-label">One platform · Every channel</p>
    <ul class="trustbar-list">
      {capabilities.map((item) => (
        <li class="trustbar-item mono">{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trustbar {
    padding-block: var(--space-16);
    border-block: 1px solid var(--color-border-subtle);
    background: var(--color-surface-muted);
  }

  .trustbar-label {
    margin: 0 0 var(--space-6);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-faint);
  }

  .trustbar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--space-4);
    align-items: center;
  }

  .trustbar-item {
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-foreground-muted);
    opacity: 0.7;
  }

  @media (min-width: 40rem) {
    .trustbar-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .trustbar-list {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>