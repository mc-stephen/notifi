---
import Icon from "../ui/Icon.astro";

const metrics = [
  { label: "Delivered today", count: 12847, decimals: 0 },
  { label: "Open rate", count: 64.2, decimals: 1, suffix: "%" },
  { label: "p95 latency", count: 412, decimals: 0, suffix: "ms" },
  { label: "Delivery rate · 30d", count: 99.98, decimals: 2, suffix: "%" },
];

const split = [
  { channel: "Email", pct: 42, count: "5,396" },
  { channel: "Push", pct: 31, count: "3,982" },
  { channel: "SMS", pct: 18, count: "2,312" },
  { channel: "Desktop", pct: 9, count: "1,157" },
];
---

<section class="section analytics" id="analytics">
  <div class="container" data-reveal>
    <header class="section-head">
      <p class="eyebrow">Analytics</p>
      <h2 class="section-title">Every send, measured.</h2>
      <p class="section-sub">
        Queued, sent, delivered, opened, bounced, failed — every event is queryable
        in the dashboard and via the events API.
      </p>
    </header>

    <div class="analytics-panel card">
      <div class="panel-head">
        <h3 class="panel-title">
          <Icon name="activity" size={18} />
          Delivery analytics
        </h3>
        <span class="chip-sample">Sample data</span>
      </div>

      <div class="metric-grid">
        {metrics.map((metric) => (
          <div class="metric">
            <p class="metric-value">
              <span
                data-count={metric.count}
                data-decimals={metric.decimals}
                data-suffix={metric.suffix ?? ""}
              >{metric.count.toLocaleString("en-US", { minimumFractionDigits: metric.decimals })}</span>
              {metric.suffix}
            </p>
            <p class="metric-label">{metric.label}</p>
          </div>
        ))}
      </div>

      <div class="panel-cols">
        <div class="split">
          <h4 class="panel-sub">Channel split</h4>
          {split.map((row) => (
            <div class="split-row">
              <span class="split-label">{row.channel}</span>
              <span class="split-track" aria-hidden="true">
                <span class="split-fill" style={`width: ${row.pct}%`}></span>
              </span>
              <span class="split-count mono">{row.count}</span>
            </div>
          ))}
        </div>

        <div class="spark">
          <h4 class="panel-sub">Sends · last 7 days</h4>
          <svg class="spark-svg" viewBox="0 0 320 96" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none">
            <defs>
              <linearGradient id="spark-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--color-primary-400)" stop-opacity="0.35" />
                <stop offset="100%" stop-color="var(--color-primary-400)" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d="M0 72 L53 58 L106 66 L159 40 L212 48 L265 22 L320 30 L320 96 L0 96 Z" fill="url(#spark-fill)" />
            <path d="M0 72 L53 58 L106 66 L159 40 L212 48 L265 22 L320 30" fill="none" stroke="var(--color-primary-400)" stroke-width="2" stroke-linecap="round" />
            <circle cx="265" cy="22" r="3.5" fill="var(--color-primary-400)" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-20);
  }

  .section-head {
    max-width: 40rem;
    margin: 0 auto var(--space-12);
    text-align: center;
  }

  .section-title {
    margin: var(--space-3) 0 0;
  }

  .section-sub {
    margin: var(--space-4) auto 0;
    color: var(--color-foreground-muted);
  }

  .analytics-panel {
    max-width: 64rem;
    margin-inline: auto;
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    display: grid;
    gap: var(--space-6);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .panel-title {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: var(--color-foreground);
  }

  .chip-sample {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-foreground-faint);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.625rem;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .metric {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border-subtle);
  }

  .metric-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-foreground);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .metric-label {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--color-foreground-muted);
  }

  .panel-cols {
    display: grid;
    gap: var(--space-6);
  }

  .panel-sub {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-faint);
  }

  .split {
    display: grid;
    align-content: start;
  }

  .split-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr 4rem;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .split-label {
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }

  .split-track {
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
  }

  .split-fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--color-primary-400), var(--color-primary-600));
  }

  .split-count {
    text-align: right;
    font-size: var(--text-xs);
    color: var(--color-foreground-muted);
  }

  .spark-svg {
    width: 100%;
    height: 6rem;
    display: block;
  }

  @media (min-width: 40rem) {
    .metric-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .panel-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import "../../islands/count";
</script>