---
interface Stage {
  key: string;
  title: string;
  sub: string;
}

const stages: Stage[] = [
  { key: "ingest", title: "Ingest", sub: "POST /v1/notifications" },
  { key: "outbox", title: "Outbox", sub: "durable · fsync before reply" },
  { key: "queue", title: "Queue", sub: "backpressure · bursts absorbed" },
  { key: "workers", title: "Workers", sub: "retries · backoff + jitter" },
  { key: "providers", title: "Providers", sub: "routing · failover" },
];
---

<div class="arch" id="architecture-diagram" data-reveal>
  <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Notifi pipeline: ingest, outbox, queue, workers, then per-channel providers with automatic failover.">
    {stages.map((stage, i) => (
      <g data-stage class="stage" tabindex="0" transform={`translate(0, ${i * 58})`}>
        <rect x="16" y="4" width="280" height="46" rx="12" class="stage-box" />
        <text x="40" y="25" class="stage-title">{stage.title}</text>
        <text x="40" y="41" class="stage-sub mono">{stage.sub}</text>
        {i < stages.length - 1 && (
          <path d="M156 50v8" class="stage-arrow" />
        )}
      </g>
    ))}
    <g transform="translate(320, 4)">
      <rect x="0" y="0" width="64" height="232" rx="12" class="provider-box" />
      <text x="32" y="22" text-anchor="middle" class="stage-sub mono">Email</text>
      <text x="32" y="90" text-anchor="middle" class="stage-sub mono">SMS</text>
      <text x="32" y="158" text-anchor="middle" class="stage-sub mono">Push</text>
      <path d="M296 27h24" class="fanout" />
      <path d="M296 89h24" class="fanout" />
      <path d="M296 151h24" class="fanout" />
    </g>
  </svg>
</div>

<style>
  .arch {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .arch svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .stage-box {
    fill: var(--color-surface-muted);
    stroke: var(--color-border-subtle);
    stroke-width: 1.2;
    transition: fill var(--dur-fast) ease, stroke var(--dur-fast) ease;
  }

  .stage:hover .stage-box,
  .stage:focus-visible .stage-box {
    fill: oklch(0.65 0.22 280 / 0.12);
    stroke: var(--color-primary-400);
  }

  [data-theme="light"] .stage:hover .stage-box,
  [data-theme="light"] .stage:focus-visible .stage-box {
    fill: oklch(0.515 0.235 280 / 0.08);
  }

  .stage-title {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    fill: var(--color-foreground);
  }

  .stage-sub {
    font-size: 11px;
    fill: var(--color-foreground-muted);
  }

  .stage-arrow {
    stroke: var(--color-border);
    stroke-width: 2;
    stroke-linecap: round;
    marker-end: none;
  }

  .provider-box {
    fill: var(--color-surface-muted);
    stroke: var(--color-border-subtle);
    stroke-width: 1.2;
  }

  .fanout {
    stroke: var(--color-primary-400);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    opacity: 0.7;
  }
</style>

<script>
  import "../../islands/architecture";
</script>