---
/**
 * Hero product showcase — a CSS-built dashboard window (no image asset).
 * Reads as the real product: window chrome, sidebar, KPIs, and a
 * live-looking notifications list with per-channel status pills.
 */
import LiveStatusPill from "./LiveStatusPill.astro";

const kpis = [
  { value: "48,210", label: "sent · 24h", note: "+12.4%", tone: "up" },
  { value: "99.98%", label: "delivery rate", note: "", tone: "" },
  { value: "412ms", label: "median latency", note: "-38ms", tone: "up" },
  { value: "13", label: "active channels", note: "2 added", tone: "" },
];

const rows = [
  {
    glyph: "E",
    tone: "email",
    template: "order-updated",
    recipient: "user@company.com",
    status: "delivered",
    meta: "412ms",
  },
  {
    glyph: "S",
    tone: "sms",
    template: "password-reset",
    recipient: "+1 (555) 012-3456",
    status: "delivered",
    meta: "388ms",
  },
  {
    glyph: "P",
    tone: "push",
    template: "weekly-digest",
    recipient: "device ···9f2k",
    status: "queued",
    meta: "—",
  },
  {
    glyph: "W",
    tone: "webhook",
    template: "alert-spike",
    recipient: "hooks.example.com",
    status: "retrying",
    meta: "2.4s",
  },
  {
    glyph: "E",
    tone: "email",
    template: "onboarding-welcome",
    recipient: "new@company.com",
    status: "delivered",
    meta: "401ms",
  },
];

const nav = [
  { label: "Overview", active: false },
  { label: "Notifications", active: true },
  { label: "Channels", active: false },
  { label: "Templates", active: false },
  { label: "Analytics", active: false },
  { label: "Settings", active: false },
];

const chips = ["All", "Delivered", "Queued", "Failed"];
---

<figure class="mock" role="img" aria-label="The Notifi dashboard: workspace, delivery metrics, and a live feed of notifications with per-channel status.">
  <div class="mock-bar">
    <span class="mock-url mono">app.notifi.dev</span>
    <div class="mock-bar-right">
      <LiveStatusPill />
      <span class="mock-create">+ New notification</span>
    </div>
  </div>

  <div class="mock-body">
    <aside class="mock-side" aria-hidden="true">
      <div class="mock-nav">
        {nav.map((item) => (
          <span class={item.active ? "mock-nav-item is-active" : "mock-nav-item"}>
            <span class="mock-nav-glyph" aria-hidden="true"></span>
            {item.label}
          </span>
        ))}
      </div>
    </aside>

    <div class="mock-main">
      <div class="mock-toolbar">
        <div class="mock-chips">
          {chips.map((chip, i) => (
            <span class={i === 0 ? "mock-chip is-active mono" : "mock-chip mono"}>{chip}</span>
          ))}
        </div>
        <span class="mock-search mono">Search notifications…</span>
      </div>

      <div class="mock-kpis">
        {kpis.map((kpi) => (
          <div class="mock-kpi">
            <p class="mock-kpi-value mono">{kpi.value}</p>
            <p class="mock-kpi-label">{kpi.label}</p>
            <p class={kpi.tone ? "mock-kpi-note is-up mono" : "mock-kpi-note mono"}>
              {kpi.note || "\u00a0"}
            </p>
          </div>
        ))}
      </div>

      <div class="mock-table" role="table" aria-label="Recent notifications">
        <div class="mock-table-head mono" role="row">
          <span>Template</span>
          <span>Recipient</span>
          <span class="mock-col-status">Status</span>
          <span>Time</span>
        </div>
        {rows.map((row) => (
          <div class="mock-row" role="row">
            <span class="mock-row-name">
              <span class={`mock-glyph ${row.tone} mono`} aria-hidden="true">{row.glyph}</span>
              <span class="mock-template mono">{row.template}</span>
            </span>
            <span class="mock-recipient mono">{row.recipient}</span>
            <span class="mock-col-status">
              <span class={`mock-status is-${row.status}`}>{row.status}</span>
            </span>
            <span class="mock-time mono">{row.meta}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</figure>

<style>
  .mock {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .mock-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.625rem 1rem;
    background: var(--color-surface-muted);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mock-url {
    font-size: var(--text-xs);
    color: var(--color-foreground-muted);
  }

  .mock-bar-right {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .mock-create {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary-400);
    color: var(--color-primary-foreground);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .mock-body {
    display: grid;
    grid-template-columns: 1fr;
  }

  .mock-side {
    display: none;
    padding: var(--space-4) 0.75rem;
    background: var(--color-surface-sunken);
    border-right: 1px solid var(--color-border-subtle);
  }

  .mock-nav {
    display: grid;
    gap: 0.25rem;
  }

  .mock-nav-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }

  .mock-nav-item.is-active {
    color: var(--color-foreground);
    background: var(--color-surface-muted);
  }

  .mock-nav-glyph {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.45;
  }

  .mock-nav-item.is-active .mock-nav-glyph {
    background: var(--color-primary-400);
    opacity: 1;
  }

  .mock-main {
    min-width: 0;
  }

  .mock-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mock-chips {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .mock-chip {
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    font-size: 11px;
    color: var(--color-foreground-muted);
  }

  .mock-chip.is-active {
    border-color: var(--color-primary-400);
    color: var(--color-primary-400);
    background: oklch(0.65 0.22 280 / 0.1);
  }

  [data-theme="light"] .mock-chip.is-active {
    color: var(--color-primary-600);
    border-color: var(--color-primary-500);
  }

  .mock-search {
    display: none;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    font-size: 11px;
    color: var(--color-foreground-faint);
    white-space: nowrap;
  }

  .mock-kpis {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mock-kpi {
    padding: 0.875rem 1rem 0.875rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mock-kpi:nth-child(odd) {
    border-right: 1px solid var(--color-border-subtle);
  }

  .mock-kpi-value {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .mock-kpi-label {
    margin: 0.125rem 0 0;
    font-size: 11px;
    color: var(--color-foreground-faint);
  }

  .mock-kpi-note {
    margin: 0.25rem 0 0;
    font-size: 10.5px;
    color: var(--color-foreground-faint);
  }

  .mock-kpi-note.is-up {
    color: var(--color-success);
  }

  .mock-table-head,
  .mock-row {
    display: grid;
    grid-template-columns: 2.2fr 1.6fr 1fr 3.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.625rem 1rem;
  }

  .mock-table-head {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-faint);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mock-row {
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background var(--dur-instant) ease;
  }

  .mock-row:last-child {
    border-bottom: none;
  }

  .mock-row:hover {
    background: var(--color-surface-muted);
  }

  .mock-row-name {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .mock-glyph {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-sm);
    font-size: 10px;
    font-weight: 600;
    flex-shrink: 0;
    color: var(--color-foreground-muted);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border-subtle);
  }

  .mock-glyph.email {
    color: var(--color-success);
    border-color: oklch(0.723 0.219 149.579 / 0.45);
  }

  .mock-glyph.sms {
    color: var(--color-info);
    border-color: oklch(0.623 0.214 259.815 / 0.45);
  }

  .mock-glyph.push {
    color: var(--color-primary-400);
    border-color: oklch(0.65 0.22 280 / 0.45);
  }

  .mock-glyph.webhook {
    color: var(--color-warning);
    border-color: oklch(0.769 0.188 70.08 / 0.45);
  }

  .mock-template {
    font-size: var(--text-xs);
    color: var(--color-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock-recipient {
    font-size: 11px;
    color: var(--color-foreground-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock-col-status {
    display: flex;
    justify-content: flex-start;
  }

  .mock-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.5625rem;
    border-radius: var(--radius-full);
    font-size: 10.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .mock-status::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .mock-status.is-delivered {
    color: var(--color-success);
    background: oklch(0.723 0.219 149.579 / 0.1);
  }

  .mock-status.is-queued {
    color: var(--color-primary-400);
    background: oklch(0.65 0.22 280 / 0.1);
  }

  [data-theme="light"] .mock-status.is-queued {
    color: var(--color-primary-600);
  }

  .mock-status.is-retrying {
    color: var(--color-warning);
    background: oklch(0.769 0.188 70.08 / 0.12);
  }

  .mock-time {
    font-size: 11px;
    color: var(--color-foreground-faint);
    text-align: right;
  }

  @media (min-width: 46rem) {
    .mock-body {
      grid-template-columns: 12.5rem 1fr;
    }

    .mock-side {
      display: block;
    }

    .mock-search {
      display: inline-block;
    }

    .mock-kpis {
      grid-template-columns: repeat(4, 1fr);
    }

    .mock-kpi {
      border-bottom: none;
    }

    .mock-kpi + .mock-kpi {
      border-left: 1px solid var(--color-border-subtle);
      border-right: none;
    }

    .mock-kpi:nth-child(odd) {
      border-right: none;
    }

    .mock-kpi:nth-child(4) {
      border-left: 1px solid var(--color-border-subtle);
    }
  }
</style>