---
/**
 * Lucide-style line icon set (24px grid, 1.75px stroke).
 * Static path content only — used with set:html, never user input.
 */
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
}

const { name, size = 20, strokeWidth = 1.75 } = Astro.props;

const paths: Record<string, string> = {
