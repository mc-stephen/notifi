---
import { highlight } from "../../lib/highlight";

interface Props {
  filename?: string;
  lang?: string;
  code: string;
}

const { filename, lang, code } = Astro.props;
const label = `Code: ${filename ?? lang ?? "example"}`;
const highlighted = await highlight(code, lang ?? "text");
---

<figure class="code-window" role="group" aria-label={label}>
  <figcaption class="code-window-bar">
    <span class="code-window-filename">
      {filename && <span class="mono">{filename}</span>}
      {lang && <span class="code-window-lang">{lang}</span>}
    </span>
    <button class="code-window-copy" type="button" data-copy={code} aria-label={`Copy ${label}`}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none">
        <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="1.8" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span data-copy-label>Copy</span>
    </button>
  </figcaption>
  <pre><code class="mono" data-code={filename} set:html={highlighted} /></pre>
</figure>

<style>
  .code-window {
    margin: 0;
    background: var(--color-code-bg);
    border: 1px solid var(--color-code-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .code-window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.625rem var(--space-4);
    background: var(--color-code-bar);
    border-bottom: 1px solid var(--color-code-border-subtle);
  }

  .code-window-filename {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
  }

  .code-window-filename .mono {
    font-size: var(--text-xs);
    color: var(--color-code-foreground-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .code-window-lang {
    font-size: var(--text-xs);
    color: var(--color-code-foreground-faint);
  }

  .code-window-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.625rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface);
    color: var(--color-foreground-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }

  .code-window-copy:hover {
    color: var(--color-foreground);
    border-color: var(--color-border);
  }

  pre {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
  }

  pre code {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: 1.6;
    color: var(--notifi-foreground);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import "../../islands/copy";
</script>