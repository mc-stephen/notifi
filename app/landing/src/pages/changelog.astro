---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import CtaBanner from "../components/sections/CtaBanner.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const typeLabel: Record<string, string> = {
  added: "Added",
  changed: "Changed",
  fixed: "Fixed",
  removed: "Removed",
};
---

<BaseLayout title="Changelog — Notifi" path="/changelog" description="The public Notifi changelog: shipped, changed, and fixed — with security advisories first.">
  <MarketingLayout>
    <PageHero
      eyebrow="Changelog"
      title="Every change, in the open."
      sub="Release notes and security advisories, published before they age 90 days."
      secondaryCta={{ label: "Subscribe via RSS", href: "/rss.xml" }}
    />

    <section class="changelog">
      <div class="container">
        {entries.length === 0 ? (
          <div class="changelog-empty card">
            <p class="changelog-empty-code mono">no releases yet</p>
            <h2>Release notes land here first.</h2>
            <p>
              The platform is in active development. Subscribe to the{" "}
              <a class="text-link" href="/rss.xml">RSS feed</a> so the next
              release reaches you the moment it ships.
            </p>
          </div>
        ) : (
          <ol class="changelog-list">
            {entries.map((entry) => (
              <li class="changelog-entry card" id={`changelog-${entry.data.slug}`}>
                <div class="changelog-head">
                  <h2>{entry.data.title}</h2>
                  <p class="changelog-date mono">
                    {entry.data.date.toISOString().slice(0, 10)}
                  </p>
                </div>
                {entry.data.release && (
                  <p class="changelog-release mono">release {entry.data.release}</p>
                )}
                <ul class="changelog-changes">
                  {entry.data.changes.map((change) => (
                    <li>
                      <span class={`change-type mode-${change.type}`}>
                        {typeLabel[change.type] ?? change.type}
                      </span>
                      <span>{change.detail}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>

    <CtaBanner />
  </MarketingLayout>
</BaseLayout>

<style>
  .changelog {
    padding-block: var(--space-16) var(--space-20);
  }

  .changelog-empty {
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-12);
  }

  .changelog-empty-code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-400);
  }

  .changelog-empty h2 {
    margin: var(--space-3) 0 0;
  }

  .changelog-empty p:not(.changelog-empty-code) {
    margin: var(--space-4) auto 0;
    color: var(--color-foreground-muted);
  }

  .changelog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    max-width: 46rem;
  }

  .changelog-entry {
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .changelog-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .changelog-head h2 {
    margin: 0;
    font-size: 1.125rem;
  }

  .changelog-date {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-foreground-faint);
  }

  .changelog-release {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-foreground-faint);
  }

  .changelog-changes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .changelog-changes li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }

  .change-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .change-type.mode-added {
    color: var(--color-success);
  }

  .change-type.mode-changed {
    color: var(--color-warning);
  }

  .change-type.mode-fixed {
    color: var(--color-info);
  }

  .change-type.mode-removed {
    color: var(--color-error);
  }

  .text-link {
    color: var(--color-primary-400);
    text-decoration: none;
  }

  [data-theme="light"] .text-link {
    color: var(--color-primary-600);
  }

  .text-link:hover {
    text-decoration: underline;
  }
</style>