---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Notifi Blog`} path={`/blog/${post.id}`} description={post.data.description}>
  <MarketingLayout>
    <article class="post-page">
      <div class="container">
        <p class="post-meta mono">
          {post.data.pubDate.toISOString().slice(0, 10)}
          {post.data.tags.length > 0 && <> · {post.data.tags.join(" · ")}</>}
        </p>
        <h1>{post.data.title}</h1>
        <div class="post-body">
          <Content />
        </div>
        <p class="post-back">
          <a class="text-link" href="/blog">&larr; All posts</a>
        </p>
      </div>
    </article>
  </MarketingLayout>
</BaseLayout>

<style>
  .post-page {
    padding-block: var(--space-16) var(--space-20);
  }

  .post-meta {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-foreground-faint);
  }

  .post-page h1 {
    margin: var(--space-4) 0 0;
  }

  .post-body {
    margin-top: var(--space-8);
    max-width: 46rem;
    color: var(--color-foreground-muted);
    line-height: 1.75;
  }

  .post-body h2 {
    margin: var(--space-12) 0 var(--space-4);
    color: var(--color-foreground);
  }

  .post-body h3 {
    margin: var(--space-8) 0 var(--space-3);
    color: var(--color-foreground);
  }

  .post-body pre {
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .post-body code {
    font-family: var(--font-mono);
    font-size: var(--text-code);
  }

  .post-back {
    margin: var(--space-12) 0 0;
  }

  .text-link {
    color: var(--color-primary-400);
    text-decoration: none;
  }

  [data-theme="light"] .text-link {
    color: var(--color-primary-600);
  }

  .text-link:hover {
    text-decoration: underline;
  }
</style>