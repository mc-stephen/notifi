# =============================================================================
# Notifi — environment template (checked into git; values live elsewhere)
# =============================================================================
#
# This file inventories EVERY `NOTIFI_*` variable the code can read, with a
# one-line explanation each. The real secrets live in `infrastructure/.env`
# (gitignored, you own the values) for local dev; in production you paste
# the SAME NAMES into your provider's env UI (e.g. Coolify), with different
# values. No secret material belongs in this file or in git — ever.
#
# Style: required keys are uncommented with fake placeholders; optional keys
# are commented out with their compiled defaults documented. Uncommenting a
# line turns it on; copying this file unchanged boots nothing accidentally.
#
# Local dev only: `.env` is loaded by the app itself (dotenvy) from
# infrastructure/.env. Plain `cargo run -p server` / `-p worker` then picks
# values up; the apps print which config they resolved at boot.
#
# A drift guard (server/tests/env_template_parity.rs) fails CI when a
# NOTIFI_* name is read somewhere but missing here, or when this file lists
# a name nothing reads. Add names here in the same change that adds them
# to the code.

# =============================================================================
# Server core (infra/config.rs)
# =============================================================================

# Postgres connection string — the only REQUIRED key for real work.
# Without it the API boots degraded (auth answers 503) and the worker has
# nothing to sweep. CI suites use a UNSET-able scratch DB, never production.
NOTIFI_DATABASE_URL=postgres://user:change-me@localhost:5432/notifi

# Postgres pool ceiling. Default: 20.
# NOTIFI_DB_MAX_CONNECTIONS=20

# API listener. Defaults: 127.0.0.1 / 8080 (bind 0.0.0.0 when behind a
# proxy/TLS terminator, which is how Coolify deploys land).
# NOTIFI_HOST=127.0.0.1
# NOTIFI_PORT=8080

# Tracing filter. Default: info (e.g. debug for request-level detail).
# NOTIFI_LOG=info

# Browser origins allowed to call the API. Default: localhost:3000
# (dashboard) + localhost:4321 (Astro apps) — add your prod origins comma-
# separated when you go live.
# NOTIFI_CORS_ORIGINS=http://localhost:3000,http://localhost:4321

# Project-config storage root for the FILE driver (R2 ignores it entirely).
# Default: `configs` relative to the working dir; repo dev pins it to
# server/assets via .cargo/config.toml. In prod with R2 configured this
# stays unset.
# NOTIFI_CONFIG_ROOT=configs

# Optional compiled-defaults overlay file (JSON path, rarely used).
# NOTIFI_CONFIG_FILE=/path/to/extra.json

# Where handlebars looks for system mail templates when the asset dir is
# non-standard. Default: the server's own assets dir (unset here).
# NOTIFI_TEMPLATES_DIR=/path/to/system-templates

# DEV ONLY: `/app/*` auth endpoints answer with a one-time invite link
# (or raw token in the response) instead of requiring real mail delivery.
# true/false; false in prod ALWAYS.
# NOTIFI_EXPOSE_DEV_TOKENS=false

# =============================================================================
# Cache & queue (both optional; each changes which keys/routes go hot)
# =============================================================================

# Redis: session store + the read-through config cache (`cfg:` namespace).
# Unset → sessions fall back to DB-backed lookups, config reads hit the
# store directly (R2 request counts go up; sends still work).
# NOTIFI_REDIS_URL=redis://default:change-me@localhost:6379

# RabbitMQ: worker sweep ticks (broadcasts/schedules/campaigns fire faster
# under orchestrated ticks in addition to the worker's own clock).
# Unset → the built-in sweep loop alone, no broker.
# NOTIFI_RABBITMQ_URL=amqp://user:change-me@localhost:5672

# =============================================================================
# Project storage — Cloudflare R2 (the config store's object driver)
# =============================================================================

# Set ALL FOUR to flip tenant projects (projects/{slug}/config/..., per-project
# files) from the filesystem driver to R2 object storage. Unset any one →
# file driver at NOTIFI_CONFIG_ROOT. The bucket is the root; same keys on
# both drivers. This is also the bucket the worker's backups land in
# (under backup/). Use an Object Read & Write token — separate tokens per
# environment (dev/prod), same names.
# NOTIFI_R2_ACCOUNT_ID=<paste-from-your-account>
# NOTIFI_R2_ACCESS_KEY_ID=<paste-from-your-account>
# NOTIFI_R2_SECRET_ACCESS_KEY=<paste-from-your-account>
# NOTIFI_R2_BUCKET=<your-bucket-name>

# =============================================================================
# Database backups (worker/src/backup.rs — self-contained block)
# =============================================================================

# Off unless switched on. true/1/yes/on (case-insensitive).
# NOTIFI_BACKUP_ENABLED=true

# Daily dump slot (24h HH:MM, server-local). Default: 03:00.
# NOTIFI_BACKUP_AT=03:00

# pg_dump binary. Default: `pg_dump` (host must have the Postgres client
# tools installed — a bare container may need the postgres-client package).
# NOTIFI_BACKUP_PG_DUMP=/usr/bin/pg_dump

# What gets dumped: this URL, else NOTIFI_DATABASE_URL above.
# NOTIFI_BACKUP_DB_URL=postgres://user:change-me@home.host:5432/notifi

# Land: `backup/postgres-{db}-{timestamp}.sql` inside the SAME R2 bucket
# as the config store (NOTIFI_R2_*); parts are 8 MiB multiparts; the file
# is plain-text SQL restorable with `psql -f`. NOTHING is ever auto-deleted.
# `cargo run -p worker -- --backup-now` = one dump-and-upload now, exit 1
# with a reason when unconfigured.

# =============================================================================
# System mail (auth/onboarding/invite mails the SERVER itself sends)
# =============================================================================

# Any working SMTP account (a dev inbox like Ethereal for local; a provider
# account in prod). Host/port/username required together; TLS defaults on
# (STARTTLS for plain 587 — accepted values: 1/true/yes, 0/false/no).
# Unset entirely → system mail helpers return None; auth flows skip mail
# (dev-token mode carries the flows instead).
# NOTIFI_SMTP_HOST=<your-smtp-host>
# NOTIFI_SMTP_PORT=587
# NOTIFI_SMTP_USERNAME=<your-smtp-user>
# NOTIFI_SMTP_PASSWORD=<your-smtp-password>
# NOTIFI_SMTP_TLS=true

# From-domain for system mail links. Default: notifi.dev.
# NOTIFI_MAIL_DOMAIN=your-domain.tld

# Public URLs the server has to know to mint valid links (invites, reset,
# OAuth redirects). Defaults: http://localhost:3000 (dashboard),
# http://localhost:4321 (admin), http://localhost:8080 (API).
# NOTIFI_DASHBOARD_URL=https://your-dashboard
# NOTIFI_ADMIN_URL=https://your-admin
# NOTIFI_API_BASE_URL=https://your-api

# =============================================================================
# OAuth sign-in apps (optional; unset → /oauth* answers 503)
# =============================================================================

# GitHub or Google (or both). Register a redirect/callback app per env and
# paste the credentials here. Secrets — never give them to anyone/anything
# but the env.
# NOTIFI_OAUTH_GITHUB_CLIENT_ID=<paste>
# NOTIFI_OAUTH_GITHUB_CLIENT_SECRET=<paste>
# NOTIFI_OAUTH_GOOGLE_CLIENT_ID=<paste>
# NOTIFI_OAUTH_GOOGLE_CLIENT_SECRET=<paste>

# =============================================================================
# Provider live-probe credentials (OPTIONAL — never needed to run anything)
# =============================================================================
#
# These exist ONLY for the `#[ignore]`-gated probe tests inside each
# channel's provider code. Run one on demand:
#      cargo test -p server <test-name> -- --ignored
# They deliver real messages to real targets — those tokens are live
# credentials, and `*_TO` vars are the actual recipient/target the probe
# fires at. All commented out by default.

# --- SMS: Twilio ---
# NOTIFI_TWILIO_ACCOUNT_SID=...   # account SID
# NOTIFI_TWILIO_AUTH_TOKEN=...    # auth token
# NOTIFI_TWILIO_FROM=...          # sender number you own
# NOTIFI_TWILIO_TO=...            # probe target number
# cargo test -p server live_twilio -- --ignored

# --- SMS: Termii ---
# NOTIFI_TERMII_API_KEY=...       # account api key
# NOTIFI_TERMII_SENDER_ID=...     # registered sender id
# NOTIFI_TERMII_TO=...            # probe target number
# cargo test -p server live_termii -- --ignored

# --- SMS: Africa's Talking ---
# NOTIFI_AT_USERNAME=...          # account username
# NOTIFI_AT_API_KEY=...           # account api key
# NOTIFI_AT_SENDER_ID=...         # short/alphanumeric sender id
# NOTIFI_AT_TO=...                # probe target number
# cargo test -p server live_africas_talking -- --ignored

# --- SMS/Chat: WhatsApp (Cloud API) ---
# NOTIFI_WHATSAPP_ACCESS_TOKEN=...    # system-user access token
# NOTIFI_WHATSAPP_PHONE_NUMBER_ID=... # business phone number id
# NOTIFI_WHATSAPP_TO=...              # probe target number
# cargo test -p server live_whatsapp -- --ignored

# --- Chat: Slack ---
# NOTIFI_SLACK_BOT_TOKEN=...      # bot user OAuth token (xoxb-…)
# NOTIFI_SLACK_CHANNEL_ID=...     # channel the bot is invited to
# cargo test -p server live_slack -- --ignored

# --- Chat: Telegram ---
# NOTIFI_TELEGRAM_BOT_TOKEN=...   # bot token from BotFather
# NOTIFI_TELEGRAM_CHAT_ID=...     # chat the bot can post in
# cargo test -p server live_telegram -- --ignored

# --- Chat: Discord ---
# NOTIFI_DISCORD_BOT_TOKEN=...    # bot token
# NOTIFI_DISCORD_CHANNEL_ID=...   # channel the bot can post in
# cargo test -p server live_discord -- --ignored

# --- Chat: Microsoft Teams ---
# NOTIFI_MS_TEAMS_WEBHOOK_URL=... # a Teams incoming-webhook URL
# cargo test -p server live_ms_teams -- --ignored

# --- Device: Android (FCM) ---
# NOTIFI_ANDROID_SERVICE_ACCOUNT=...  # path or JSON of the FCM service account
# NOTIFI_ANDROID_DEVICE_TOKEN=...     # a real device's registration token
# cargo test -p server live_android -- --ignored

# --- Device: iOS (APNs) ---
# NOTIFI_APNS_P8_PATH=...         # .p8 signing key file path
# NOTIFI_APNS_KEY_ID=...          # key id from Apple developer console
# NOTIFI_APNS_TEAM_ID=...         # Apple team id
# NOTIFI_APNS_BUNDLE_ID=...       # app bundle id
# NOTIFI_APNS_SANDBOX=...         # sandbox (default true when unset)
# NOTIFI_APNS_DEVICE_TOKEN=...    # a real device push token
# cargo test -p server live_apns -- --ignored

# --- Device: Windows (WNS) ---
# NOTIFI_WNS_CLIENT_ID=...        # Azure AD app client id
# NOTIFI_WNS_CLIENT_SECRET=...    # Azure AD app client secret
# NOTIFI_WNS_PACKAGE_SID=...      # package security identifier
# NOTIFI_WNS_CHANNEL_URI=...      # a real device channel URI
# cargo test -p server live_wns -- --ignored

# --- Web push (VAPID + subscription) ---
# NOTIFI_WEB_VAPID_PUBLIC_KEY=...   # VAPID public key (base64url)
# NOTIFI_WEB_VAPID_PRIVATE_KEY=...  # VAPID private key
# NOTIFI_WEB_VAPID_CONTACT=...      # contact email for complaints support
# NOTIFI_WEB_SUB_ENDPOINT=...       # a real generated subscription endpoint
# NOTIFI_WEB_SUB_P256DH=...         # subscription client public key
# NOTIFI_WEB_SUB_AUTH=...           # subscription auth secret
# cargo test -p server live_web_push -- --ignored

# =============================================================================
# Gated test suites (local dev against your own scratch services)
# =============================================================================
#
# The SQL/doc store suites and the Redis cache suite refuse to run without
# these, so CI never needs them and prod envs never carry them. Point them
# at disposable databases/instances ONLY.
# NOTIFI_TEST_DATABASE_URL=postgres://user:pass@localhost:5432/notifi_test
# NOTIFI_TEST_REDIS_URL=redis://default:pass@localhost:6379/15
