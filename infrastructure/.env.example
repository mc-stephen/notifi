# =============================================================================
# Notifi — environment template (checked into git; values live elsewhere)
# =============================================================================
#
# Two halves, both truth:
#
#   1. YOUR DEV FILE — a mirror of a working `infrastructure/.env` (the
#      gitignored one you own) in the same order, with dummy values. The six
#      open lines are all a bare boot refuses to start without; every other
#      line turns its feature on the moment you uncomment it into your real
#      `.env`.
#
#   2. THE FULL INVENTORY — every other `NOTIFI_*` name the code can read:
#      boot knobs, live-probe credentials, gated test suites. One terse line
#      each. The drift guard (server/tests/env_template_parity.rs) fails CI
#      when a name is read by code but missing here, listed here but never
#      read, or uncommented beyond the required six — so this inventory can
#      never quietly rot. Real secrets live only in `infrastructure/.env`
#      locally / your provider's env UI in production — never here, never
#      in git.
#
# Local dev only: `.env` is loaded by the app itself (dotenvy) from
# infrastructure/.env — plain `cargo run -p server` / `-p worker` picks it
# up and prints which config it resolved at boot.

# =============================================================================
# 1. Your dev file (mirrors infrastructure/.env — dummy values, same order)
# =============================================================================

# Redis — the server refuses to boot without it (the config cache and
# queue plumbing ride a reachable Redis).
NOTIFI_REDIS_URL=redis://default:change-me@localhost:6379

# Postgres — migrations run at boot; the worker has nothing to sweep
# without it either.
NOTIFI_DATABASE_URL=postgres://user:change-me@localhost:5432/notifi

# RabbitMQ — worker sweep ticks (schedules/campaigns fire faster under
# orchestrated ticks on top of the worker's own clock). Unset = the
# built-in sweep loop alone, no broker.
# NOTIFI_RABBITMQ_URL=amqp://user:change-me@localhost:5672

# OAuth sign-in (register a redirect/callback app per environment; unset
# means the /oauth routes answer 503).
# NOTIFI_OAUTH_GITHUB_CLIENT_ID=<paste>
# NOTIFI_OAUTH_GITHUB_CLIENT_SECRET=<paste>
# NOTIFI_OAUTH_GOOGLE_CLIENT_SECRET=<paste>
# NOTIFI_OAUTH_GOOGLE_CLIENT_ID=<paste>

# System mail — the SMTP account the server itself sends from
# (auth/onboarding/invite mails). Unset entirely = auth flows skip mail
# and dev-token mode carries them instead.
# NOTIFI_SMTP_PORT=587
# NOTIFI_MAIL_DOMAIN=your-domain.tld
# NOTIFI_SMTP_HOST=<your-smtp-host>
# NOTIFI_SMTP_PASSWORD=<your-smtp-password>
# NOTIFI_SMTP_USERNAME=<your-smtp-user>
# NOTIFI_SMTP_TLS=true

# Cloudflare R2 — REQUIRED (R2-or-nothing: the config store's only driver).
# The bucket is the store's root and where database backups land. Use an
# Object Read & Write token — separate tokens per environment (dev/prod),
# same names.
NOTIFI_R2_ACCOUNT_ID=<paste-from-your-account>
NOTIFI_R2_ACCESS_KEY_ID=<paste-from-your-account>
NOTIFI_R2_SECRET_ACCESS_KEY=<paste-from-your-account>
NOTIFI_R2_BUCKET=<your-bucket-name>

# Database backups — the self-contained worker block
# (worker/src/jobs/db_backup.rs: daily pg_dump streamed into the bucket's
# backup/ folder; nothing is ever auto-deleted).
# NOTIFI_BACKUP_ENABLED=true
# NOTIFI_BACKUP_PG_DUMP=/usr/bin/pg_dump

# The six open lines above are exactly what a fresh boot refuses without —
# the parity suite pins that set and the placeholder discipline below.

# =============================================================================
# 2. The rest of the boot inventory (uncomment what your feature needs)
# =============================================================================

# API / process knobs (all have compiled defaults).
# NOTIFI_DB_MAX_CONNECTIONS=20          # pool ceiling
# NOTIFI_HOST=127.0.0.1                 # bind 0.0.0.0 behind a proxy/TLS terminator
# NOTIFI_PORT=8080
# NOTIFI_LOG=info                       # tracing filter
# NOTIFI_CORS_ORIGINS=http://localhost:3000,http://localhost:4321  # add prod origins
# NOTIFI_CONFIG_FILE=/path/to/extra.json  # compiled-defaults overlay (rarely used)
# NOTIFI_EXPOSE_DEV_TOKENS=false        # DEV ONLY: /app auth answers with invite links instead of mail; false in prod ALWAYS

# More backup knobs.
# NOTIFI_BACKUP_AT=03:00                # daily dump slot (24h HH:MM, server-local)
# NOTIFI_BACKUP_DB_URL=postgres://user:change-me@other.host:5432/notifi  # else the main database url

# Public URLs the server mints links with (invites, resets, OAuth redirects).
# NOTIFI_DASHBOARD_URL=https://your-dashboard
# NOTIFI_ADMIN_URL=https://your-admin
# NOTIFI_API_BASE_URL=https://your-api

# =============================================================================
# 3. Provider live-probe credentials — OPTIONAL, never needed to run anything
# =============================================================================
#
# Only the ignore-gated probe tests inside each channel's provider code read
# these. Run one on demand:  cargo test -p server live_<provider> -- --ignored
# They deliver REAL messages to REAL targets — the tokens are live creds and
# every *_TO value is the target the probe fires at. All commented by
# default; CI never has them.

# --- SMS: Twilio ---
# NOTIFI_TWILIO_ACCOUNT_SID=...         # account SID
# NOTIFI_TWILIO_AUTH_TOKEN=...          # auth token
# NOTIFI_TWILIO_FROM=...                # a sender number you own
# NOTIFI_TWILIO_TO=...                  # probe target number

# --- SMS: Vonage ---
# NOTIFI_VONAGE_API_KEY=...             # account api key
# NOTIFI_VONAGE_API_SECRET=...          # account api secret
# NOTIFI_VONAGE_FROM=...                # sender number/name you own
# NOTIFI_VONAGE_TO=...                  # probe target number

# --- SMS: Infobip ---
# NOTIFI_INFOBIP_API_KEY=...            # account api key
# NOTIFI_INFOBIP_BASE_URL=...           # your account endpoint (xxxx.api.infobip.com)
# NOTIFI_INFOBIP_SENDER_ID=...          # registered sender name
# NOTIFI_INFOBIP_TO=...                 # probe target number

# --- SMS: Bird ---
# NOTIFI_BIRD_API_KEY=...               # access key
# NOTIFI_BIRD_FROM=...                  # sender name/number you own
# NOTIFI_BIRD_TO=...                    # probe target number

# --- SMS: EbulkSms ---
# NOTIFI_EBULKSMS_USERNAME=...          # account username (email)
# NOTIFI_EBULKSMS_API_KEY=...           # api key from their dashboard
# NOTIFI_EBULKSMS_FROM=...              # registered sender name
# NOTIFI_EBULKSMS_TO=...                # probe target number

# --- SMS: SmsLive247 ---
# NOTIFI_SMSLIVE247_API_KEY=...         # secret key (MA-...)
# NOTIFI_SMSLIVE247_FROM=...            # registered sender id
# NOTIFI_SMSLIVE247_TO=...              # probe target number

# --- SMS: Termii ---
# NOTIFI_TERMII_API_KEY=...             # account api key
# NOTIFI_TERMII_SENDER_ID=...           # registered sender id
# NOTIFI_TERMII_TO=...                  # probe target number

# --- SMS: Africa's Talking ---
# NOTIFI_AT_USERNAME=...                # account username
# NOTIFI_AT_API_KEY=...                 # account api key
# NOTIFI_AT_SENDER_ID=...               # short/alphanumeric sender id
# NOTIFI_AT_TO=...                      # probe target number

# --- SMS/Chat: WhatsApp (Cloud API) ---
# NOTIFI_WHATSAPP_ACCESS_TOKEN=...      # system-user access token
# NOTIFI_WHATSAPP_PHONE_NUMBER_ID=...   # business phone number id
# NOTIFI_WHATSAPP_TO=...                # probe target number

# --- Chat: Slack ---
# NOTIFI_SLACK_BOT_TOKEN=...            # bot user OAuth token (xoxb-…)
# NOTIFI_SLACK_CHANNEL_ID=...           # channel the bot is invited to

# --- Chat: Telegram ---
# NOTIFI_TELEGRAM_BOT_TOKEN=...         # bot token from BotFather
# NOTIFI_TELEGRAM_CHAT_ID=...           # chat the bot can post in

# --- Chat: Discord ---
# NOTIFI_DISCORD_BOT_TOKEN=...          # bot token
# NOTIFI_DISCORD_CHANNEL_ID=...         # channel the bot can post in

# --- Chat: Microsoft Teams ---
# NOTIFI_MS_TEAMS_WEBHOOK_URL=...       # an incoming-webhook URL

# --- Device: Android (FCM) ---
# NOTIFI_ANDROID_SERVICE_ACCOUNT=...    # path or JSON of the FCM service account
# NOTIFI_ANDROID_DEVICE_TOKEN=...       # a real device's registration token

# --- Device: iOS (APNs) ---
# NOTIFI_APNS_P8_PATH=...               # signing key file path
# NOTIFI_APNS_KEY_ID=...                # key id from the Apple developer console
# NOTIFI_APNS_TEAM_ID=...               # Apple team id
# NOTIFI_APNS_BUNDLE_ID=...             # app bundle id
# NOTIFI_APNS_SANDBOX=...               # sandbox (default true when unset)
# NOTIFI_APNS_DEVICE_TOKEN=...          # a real device push token

# --- Device: Windows (WNS) ---
# NOTIFI_WNS_CLIENT_ID=...              # Azure AD app client id
# NOTIFI_WNS_CLIENT_SECRET=...          # Azure AD app client secret
# NOTIFI_WNS_PACKAGE_SID=...            # package security identifier
# NOTIFI_WNS_CHANNEL_URI=...            # a real device channel URI

# --- Web push (VAPID + subscription) ---
# NOTIFI_WEB_VAPID_PUBLIC_KEY=...       # VAPID public key (base64url)
# NOTIFI_WEB_VAPID_PRIVATE_KEY=...      # VAPID private key
# NOTIFI_WEB_VAPID_CONTACT=...          # contact email for complaints support
# NOTIFI_WEB_SUB_ENDPOINT=...           # a real generated subscription endpoint
# NOTIFI_WEB_SUB_P256DH=...             # subscription client public key
# NOTIFI_WEB_SUB_AUTH=...               # subscription auth secret

# --- Android (Pushy) ---
# NOTIFI_PUSHY_API_KEY=...              # secret api key from their dashboard
# NOTIFI_PUSHY_DEVICE_TOKEN=...         # a real device registration token

# --- Android + Apple (OneSignal) ---
# NOTIFI_ONESIGNAL_APP_ID=...           # app id from their keys & ids page
# NOTIFI_ONESIGNAL_REST_API_KEY=...     # REST API key
# NOTIFI_ONESIGNAL_SUBSCRIPTION_ID=...  # a real subscription id

# =============================================================================
# 4. Gated test suites (local dev against disposable services ONLY)
# =============================================================================
#
# The SQL/store suites and the Redis cache suite refuse to run without
# these, so CI never needs them and prod envs never carry them.
# NOTIFI_TEST_DATABASE_URL=postgres://user:pass@localhost:5432/notifi_test
# NOTIFI_TEST_REDIS_URL=redis://default:pass@localhost:6379/15
